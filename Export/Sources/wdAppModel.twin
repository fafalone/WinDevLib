Public Enum AppModelPackageFlags
    PACKAGE_PROPERTY_FRAMEWORK = &H00000001
    PACKAGE_PROPERTY_RESOURCE = &H00000002
    PACKAGE_PROPERTY_BUNDLE = &H00000004
    PACKAGE_PROPERTY_OPTIONAL = &H00000008
    PACKAGE_FILTER_HEAD = &H00000010
    PACKAGE_FILTER_DIRECT = &H00000020
    PACKAGE_FILTER_RESOURCE = &H00000040
    PACKAGE_FILTER_BUNDLE = &H00000080
    PACKAGE_INFORMATION_BASIC = &H00000000
    PACKAGE_INFORMATION_FULL = &H00000100
    PACKAGE_PROPERTY_DEVELOPMENT_MODE = &H00010000
    PACKAGE_FILTER_OPTIONAL = &H00020000
    PACKAGE_PROPERTY_IS_IN_RELATED_SET = &H00040000
    PACKAGE_FILTER_IS_IN_RELATED_SET = PACKAGE_PROPERTY_IS_IN_RELATED_SET
    PACKAGE_PROPERTY_STATIC = &H00080000
    PACKAGE_FILTER_STATIC = PACKAGE_PROPERTY_STATIC
    PACKAGE_PROPERTY_DYNAMIC = &H00100000
    PACKAGE_FILTER_DYNAMIC = PACKAGE_PROPERTY_DYNAMIC
    ' #if NTDDI_VERSION >= NTDDI_WIN10_MN
    PACKAGE_PROPERTY_HOSTRUNTIME = &H00200000
    PACKAGE_FILTER_HOSTRUNTIME = PACKAGE_PROPERTY_HOSTRUNTIME
    PACKAGE_FILTER_ALL_LOADED = 0
End Enum

