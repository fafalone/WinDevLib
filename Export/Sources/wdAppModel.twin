Module wdAppModel

'minappmodel.h

'  These constants define the lengths of various portions of a package
'  identity string. These lengths are measured in characters and do not
'  include space for NULL terminators.

Public Const PACKAGE_ARCHITECTURE_MIN_LENGTH  = 3
Public Const PACKAGE_ARCHITECTURE_MAX_LENGTH  = 7
Public Const PACKAGE_VERSION_MIN_LENGTH  = 7 /* "a.b.c.d" where abcd=0 */
Public Const PACKAGE_VERSION_MAX_LENGTH  = 23 /* "a.b.c.d" where abcd=65535 */
Public Const PACKAGE_NAME_MIN_LENGTH  = 3
Public Const PACKAGE_NAME_MAX_LENGTH  = 50
Public Const PACKAGE_PUBLISHER_MIN_LENGTH  = 3 /* "S=x" */
Public Const PACKAGE_PUBLISHER_MAX_LENGTH  = 8192
Public Const PACKAGE_PUBLISHERID_MIN_LENGTH  = 13
Public Const PACKAGE_PUBLISHERID_MAX_LENGTH  = 13
Public Const PACKAGE_RESOURCEID_MIN_LENGTH  = 0
Public Const PACKAGE_RESOURCEID_MAX_LENGTH  = 30
Public Const PACKAGE_FULL_NAME_MIN_LENGTH  = (PACKAGE_NAME_MIN_LENGTH + 1 + PACKAGE_VERSION_MIN_LENGTH + 1 + PACKAGE_ARCHITECTURE_MIN_LENGTH + 1 + PACKAGE_RESOURCEID_MIN_LENGTH + 1 + PACKAGE_PUBLISHERID_MIN_LENGTH)
Public Const PACKAGE_FULL_NAME_MAX_LENGTH  = (PACKAGE_NAME_MAX_LENGTH + 1 + PACKAGE_VERSION_MAX_LENGTH + 1 + PACKAGE_ARCHITECTURE_MAX_LENGTH + 1 + PACKAGE_RESOURCEID_MAX_LENGTH + 1 + PACKAGE_PUBLISHERID_MAX_LENGTH)
Public Const PACKAGE_FAMILY_NAME_MIN_LENGTH  = (PACKAGE_NAME_MIN_LENGTH + 1 + PACKAGE_PUBLISHERID_MIN_LENGTH)
Public Const PACKAGE_FAMILY_NAME_MAX_LENGTH  = (PACKAGE_NAME_MAX_LENGTH + 1 + PACKAGE_PUBLISHERID_MAX_LENGTH)
'  These constants define the bounds of package dependencies.
Public Const PACKAGE_MIN_DEPENDENCIES  = 0
Public Const PACKAGE_MAX_DEPENDENCIES  = 128
Public Const PACKAGE_FAMILY_MIN_RESOURCE_PACKAGES  = 0
Public Const PACKAGE_FAMILY_MAX_RESOURCE_PACKAGES  = 512
Public Const PACKAGE_GRAPH_MIN_SIZE  = 1
Public Const PACKAGE_GRAPH_MAX_SIZE  = (1 + PACKAGE_MAX_DEPENDENCIES + PACKAGE_FAMILY_MAX_RESOURCE_PACKAGES)
'  These constants define the bounds of applications.
Public Const PACKAGE_APPLICATIONS_MIN_COUNT  = 0
Public Const PACKAGE_APPLICATIONS_MAX_COUNT  = 100
'  These constants define the lengths of various portions of an application
'  identity string. These lengths are measured in characters and include
'  space for NULL terminators.
Public Const PACKAGE_RELATIVE_APPLICATION_ID_MIN_LENGTH  = (1 + 1)
Public Const PACKAGE_RELATIVE_APPLICATION_ID_MAX_LENGTH  = (64 + 1)
Public Const APPLICATION_USER_MODEL_ID_MIN_LENGTH  = (PACKAGE_FAMILY_NAME_MIN_LENGTH + 1 + PACKAGE_RELATIVE_APPLICATION_ID_MIN_LENGTH)
Public Const APPLICATION_USER_MODEL_ID_MAX_LENGTH  = (PACKAGE_FAMILY_NAME_MAX_LENGTH + 1 + PACKAGE_RELATIVE_APPLICATION_ID_MAX_LENGTH)


'appmodel.h
Private Type appmodpkghlp
    Revision As Integer
    build As Integer
    minor As Integer
    major As Integer
End Type
[PackingAlignment(4)]
Public Type PACKAGE_VERSION
'union {
'    UINT64 Version;
'    struct {
'        USHORT Revision;
'        USHORT Build;
'        USHORT Minor;
'        USHORT Major;
'    } DUMMYSTRUCTNAME;
'} DUMMYUNIONNAME;
    Version As LongLong
    
    'EUS
    Public Property Get Revision() As Integer
        Return CType(Of appmodpkghlp)(VarPtr(Me.Version)).Revision
    End Property
    Public Property Let Revision(ByVal value As Integer)
        CType(Of appmodpkghlp)(VarPtr(Me.Version)).Revision = value
    End Property
    Public Property Get Build() As Integer
        Return CType(Of appmodpkghlp)(VarPtr(Me.Version)).build
    End Property
    Public Property Let Build(ByVal value As Integer)
        CType(Of appmodpkghlp)(VarPtr(Me.Version)).build = value
    End Property
    Public Property Get Minor() As Integer
        Return CType(Of appmodpkghlp)(VarPtr(Me.Version)).minor
    End Property
    Public Property Let Minor(ByVal value As Integer)
        CType(Of appmodpkghlp)(VarPtr(Me.Version)).minor = value
    End Property
    Public Property Get Major() As Integer
        Return CType(Of appmodpkghlp)(VarPtr(Me.Version)).major
    End Property
    Public Property Let Major(ByVal value As Integer)
        CType(Of appmodpkghlp)(VarPtr(Me.Version)).major = value
    End Property
End Type

[PackingAlignment(4)]
Public Type PACKAGE_ID
    reserved As Long
    processorArchitecture As Long
    version As PACKAGE_VERSION
    name As LongPtr
    publisher As LongPtr
    resourceId As LongPtr
    publisherId As LongPtr
End Type

