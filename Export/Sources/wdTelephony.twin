    dwIPv4NegotiationError As Long
    ipv4Address As RASIPV4ADDR
    ipv4ServerAddress As RASIPV4ADDR
    dwIPv4Options As RasPPPOptions
    dwIPv4ServerOptions As RasPPPOptions
    ' IPv6 Projection Parameters
    dwIPv6NegotiationError As Long
    bInterfaceIdentifier(0 To 7) As Byte
    bServerInterfaceIdentifier(0 To 7) As Byte
    ' LCP Options
    fBundled As BOOL
    fMultilink As BOOL
    dwAuthenticationProtocol As RasAuthProtocolValues
    dwAuthenticationData As RasAuthDataValues
    dwServerAuthenticationProtocol As RasAuthProtocolValues
    dwServerAuthenticationData As RasAuthDataValues
    dwEapTypeId As EapTypeConsts
    dwServerEapTypeId As Long
    dwLcpOptions As RasPPPLCPOptions
    dwLcpServerOptions As RasPPPLCPOptions
    ' CCP options
    dwCcpError As Long
    dwCcpCompressionAlgorithm As RasCCPCA_Algorithms
    dwCcpServerCompressionAlgorithm As RasCCPCA_Algorithms
    dwCcpOptions As RasCCPCA_Options
    dwCcpServerOptions As RasCCPCA_Options
End Type

Public Enum RasIKEv2Flags
    RASIKEv2_FLAGS_MOBIKESUPPORTED = &H00000001
    RASIKEv2_FLAGS_BEHIND_NAT = &H00000002
    RASIKEv2_FLAGS_SERVERBEHIND_NAT = &H00000004
End Enum

Public Enum RasIKEv2AuthProtocols
    RASIKEv2_AUTH_MACHINECERTIFICATES = 1
    RASIKEv2_AUTH_EAP = 2
    RASIKEv2_AUTH_PSK = 3
End Enum

[PackingAlignment(4)]
Public Type RASIKEV2_PROJECTION_INFO
    ' IPv4 Projection Parameters
    dwIPv4NegotiationError As Long
    ipv4Address As RASIPV4ADDR
    ipv4ServerAddress As RASIPV4ADDR
    ' IPv6 Projection Parameters
    dwIPv6NegotiationError As Long
    ipv6Address As RASIPV6ADDR
    ipv6ServerAddress As RASIPV6ADDR
    dwPrefixLength As Long
    ' AUTH
    dwAuthenticationProtocol As RasIKEv2AuthProtocols
    dwEapTypeId As EapTypeConsts
    dwFlags As RasIKEv2Flags
    dwEncryptionMethod As IPSEC_CIPHER_TYPE
    numIPv4ServerAddresses As Long
    ipv4ServerAddresses As LongPtr 'RASIPV4ADDR *
    numIPv6ServerAddresses As Long
    ipv6ServerAddresses As LongPtr 'RASIPV6ADDR *
End Type

Public Enum RASPROJECTION_INFO_TYPE
	PROJECTION_INFO_TYPE_PPP = 1
	PROJECTION_INFO_TYPE_IKEv2
End Enum

Public Enum IKEV2_ID_PAYLOAD_TYPE
	IKEV2_ID_PAYLOAD_TYPE_INVALID = 0
	IKEV2_ID_PAYLOAD_TYPE_IPV4_ADDR = 1      ' A single four (4) octet IPv4 address
	IKEV2_ID_PAYLOAD_TYPE_FQDN = 2           ' A fully-qualified domain name string, e.g., "example.com"
	IKEV2_ID_PAYLOAD_TYPE_RFC822_ADDR = 3    ' A fully-qualified RFC 822 email address string, e.g., "jsmith@example.com".
	IKEV2_ID_PAYLOAD_TYPE_RESERVED1 = 4      ' Reserved-Not used
	IKEV2_ID_PAYLOAD_TYPE_ID_IPV6_ADDR = 5   ' A single sixteen (16) octet IPv6 address.
	IKEV2_ID_PAYLOAD_TYPE_RESERVED2 = 6      ' Reserved-Not used
	IKEV2_ID_PAYLOAD_TYPE_RESERVED3 = 7      ' Reserved-Not used
	IKEV2_ID_PAYLOAD_TYPE_RESERVED4 = 8      ' Reserved-Not used
	IKEV2_ID_PAYLOAD_TYPE_DER_ASN1_DN = 9    ' The binary Distinguished Encoding Rules (DER) encoding of an ASN.1 X.500 Distinguished Name [PKIX].
	IKEV2_ID_PAYLOAD_TYPE_DER_ASN1_GN = 10   ' The binary DER encoding of an ASN.1 X.509 GeneralName [PKIX
	IKEV2_ID_PAYLOAD_TYPE_KEY_ID = 11        ' Reserved-Not used
	IKEV2_ID_PAYLOAD_TYPE_MAX
End Enum

Public Type RAS_PROJECTION_INFO
	version As RASAPIVERSION
	type As RASPROJECTION_INFO_TYPE
	' Based on the connectionFlags, it should use appropriate projection info
	'union {
	'    RASPPP_PROJECTION_INFO     ppp;
	'    RASIKEV2_PROJECTION_INFO   ikev2;
	'};
    u(99) As Byte
End Type

