#Region "mgm.h"

Public Type MGM_IF_ENTRY
	dwIfIndex As Long
	dwIfNextHopAddr As Long
	bIGMP As BOOL
	bIsEnabled As BOOL
End Type

Public Delegate Function MGM_RPF_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByRef pdwInIfIndex As Long, ByRef pdwInIfNextHopAddr As Long, ByRef pdwUpStreamNbr As Long, ByVal dwHdrSize As Long, ByVal pbPacketHdr As LongPtr, ByVal pbRoute As LongPtr) As Long
Public Delegate Function MGM_CREATION_ALERT_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwInIfIndex As Long, ByVal dwInIfNextHopAddr As Long, ByVal dwIfCount As Long, ByRef pmieOutIfList As MGM_IF_ENTRY) As Long
Public Delegate Function MGM_PRUNE_ALERT_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long, ByVal bMemberDelete As BOOL, ByRef pdwTimeout As Long) As Long
Public Delegate Function MGM_JOIN_ALERT_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal bMemberUpdate As BOOL) As Long
Public Delegate Function MGM_WRONG_IF_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwGroupAddr As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long, ByVal dwHdrSize As Long, ByVal pbPacketHdr As LongPtr) As Long
Public Delegate Function MGM_LOCAL_JOIN_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
Public Delegate Function MGM_LOCAL_LEAVE_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
Public Delegate Function MGM_DISABLE_IGMP_CALLBACK (ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
Public Delegate Function MGM_ENABLE_IGMP_CALLBACK (ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long

' #If WDL_NO_DELEGATES Then
Public Type ROUTING_PROTOCOL_CONFIG
	dwCallbackFlags As Long
	pfnRpfCallback As LongPtr 'MGM_RPF_CALLBACK
	pfnCreationAlertCallback As LongPtr 'MGM_CREATION_ALERT_CALLBACK
	pfnPruneAlertCallback As LongPtr 'MGM_PRUNE_ALERT_CALLBACK
	pfnJoinAlertCallback As LongPtr 'MGM_JOIN_ALERT_CALLBACK
	pfnWrongIfCallback As LongPtr 'MGM_WRONG_IF_CALLBACK
	' callbacks into Routing protocols
	pfnLocalJoinCallback As LongPtr 'MGM_LOCAL_JOIN_CALLBACK
	pfnLocalLeaveCallback As LongPtr 'MGM_LOCAL_LEAVE_CALLBACK
	' callbacks into IGMP
	pfnDisableIgmpCallback As LongPtr 'MGM_DISABLE_IGMP_CALLBACK
	pfnEnableIgmpCallback As LongPtr 'MGM_ENABLE_IGMP_CALLBACK
End Type
' #Else
' Public Type ROUTING_PROTOCOL_CONFIG
    ' dwCallbackFlags As Long
    ' pfnRpfCallback As MGM_RPF_CALLBACK
    ' pfnCreationAlertCallback As MGM_CREATION_ALERT_CALLBACK
    ' pfnPruneAlertCallback As MGM_PRUNE_ALERT_CALLBACK
    ' pfnJoinAlertCallback As MGM_JOIN_ALERT_CALLBACK
    ' pfnWrongIfCallback As MGM_WRONG_IF_CALLBACK
    ' ' callbacks into Routing protocols
    ' pfnLocalJoinCallback As MGM_LOCAL_JOIN_CALLBACK
    ' pfnLocalLeaveCallback As MGM_LOCAL_LEAVE_CALLBACK
    ' ' callbacks into IGMP
    ' pfnDisableIgmpCallback As MGM_DISABLE_IGMP_CALLBACK
    ' pfnEnableIgmpCallback As MGM_ENABLE_IGMP_CALLBACK
' End Type
' #End If

Public Enum MGM_ENUM_TYPES
	ANY_SOURCE = 0  ' enumerate group entries with
					'  atleast one source
	ALL_SOURCES     ' enumerate all source entries
					'  for a group entry
End Enum

Public Type SOURCE_GROUP_ENTRY
	dwSourceAddr As Long
	dwSourceMask As Long
	dwGroupAddr As Long
	dwGroupMask As Long
End Type

Public Enum MgmStateFlags
	MGM_JOIN_STATE_FLAG = &H00000001
	MGM_FORWARD_STATE_FLAG = &H00000002
End Enum

[UseGetLastError(False)]
Public Declare PtrSafe Function MgmRegisterMProtocol Lib "rtm.dll" (ByRef prpiInfo As ROUTING_PROTOCOL_CONFIG, ByVal dwProtocolId As Long, ByVal dwComponentId As Long, ByRef phProtocol As LongPtr) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmDeRegisterMProtocol Lib "rtm.dll" (ByVal hProtocol As LongPtr) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmTakeInterfaceOwnership Lib "rtm.dll" (ByVal hProtocol As LongPtr, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmReleaseInterfaceOwnership Lib "rtm.dll" (ByVal hProtocol As LongPtr, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGetProtocolOnInterface Lib "rtm.dll" (ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long, ByRef pdwIfProtocolId As Long, ByRef pdwIfComponentId As Long) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmAddGroupMembershipEntry Lib "rtm.dll" (ByVal hProtocol As LongPtr, ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopIPAddr As Long, ByVal dwFlags As MgmStateFlags) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmDeleteGroupMembershipEntry Lib "rtm.dll" (ByVal hProtocol As LongPtr, ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopIPAddr As Long, ByVal dwFlags As MgmStateFlags) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGetMfe Lib "rtm.dll" (ByRef pimm As MIB_IPMCAST_MFE, ByRef pdwBufferSize As Long, ByVal pbBuffer As LongPtr) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGetFirstMfe Lib "rtm.dll" (ByRef pdwBufferSize As Long, ByRef pbBuffer As Any, ByRef pdwNumEntries As Long) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGetNextMfe Lib "rtm.dll" (ByRef pimmStart As MIB_IPMCAST_MFE, ByRef pdwBufferSize As Long, ByRef pbBuffer As Any, ByRef pdwNumEntries As Long) As Long

Public Enum MgmMfeStats
	' Include statistics corresponding to MIB_IPMCAST_MFE_STATS
	MGM_MFE_STATS_0 = &H00000001
	'  Include statistics corresponding to MIB_IPMCAST_MFE_STATS_EX
	MGM_MFE_STATS_1 = &H00000002
End Enum

[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGetMfeStats Lib "rtm.dll" (ByRef pimm As MIB_IPMCAST_MFE, ByRef pdwBufferSize As Long, ByRef pbBuffer As Any, ByVal dwFlags As MgmMfeStats) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGetFirstMfeStats Lib "rtm.dll" (ByRef pdwBufferSize As Long, ByRef pbBuffer As Any, ByRef pdwNumEntries As Long, ByVal dwFlags As MgmMfeStats) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGetNextMfeStats Lib "rtm.dll" (ByRef pimmStart As MIB_IPMCAST_MFE, ByRef pdwBufferSize As Long, ByRef pbBuffer As Any, ByRef pdwNumEntries As Long, ByVal dwFlags As MgmMfeStats) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGroupEnumerationStart Lib "rtm.dll" (ByVal hProtocol As LongPtr, ByVal metEnumType As MGM_ENUM_TYPES, ByRef phEnumHandle As LongPtr) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGroupEnumerationGetNext Lib "rtm.dll" (ByVal hEnum As LongPtr, ByRef pdwBufferSize As Long, ByRef pbBuffer As Any, ByRef pdwNumEntries As Long) As Long
[UseGetLastError(False)]
Public Declare PtrSafe Function MgmGroupEnumerationEnd Lib "rtm.dll" (ByVal hEnum As LongPtr) As Long
[UseGetLastError(False)]
