Public Enum FAX_ENUM_JOB_SEND_ATTRIBUTES
	JSA_NOW = 0            ' Send now
	JSA_SPECIFIC_TIME      ' Send at specific time
	JSA_DISCOUNT_PERIOD    ' Send at server configured discount period
End Enum

Public Enum FAX_ENUM_DELIVERY_REPORT_TYPES
	DRT_NONE = &H0000  ' Do not send receipt
	DRT_EMAIL = &H0001 ' Send receipt by email
	DRT_INBOX = &H0002 ' send receipt to local inbox
End Enum

Public Type FAX_JOB_PARAMA
	SizeOfStruct As Long               ' size of this structure
	RecipientNumber As String          ' recipient fax number
	RecipientName As String            ' recipient name
	Tsid As String                     ' transmitter's id
	SenderName As String               ' sender name
	SenderCompany As String            ' sender company
	SenderDept As String               ' sender department
	BillingCode As String              ' billing code
	ScheduleAction As Long             ' when to schedule the fax, see JSA defines
	ScheduleTime As SYSTEMTIME         ' time to send the fax when JSA_SPECIFIC_TIME is used (must be local time)
	DeliveryReportType As Long         ' delivery report type, see DRT defines
	DeliveryReportAddress As String    ' email address for delivery report (ndr or dr) thru MAPI / SMTP
	DocumentName As String             ' document name (optional)
	CallHandle As Long 'HCALL          ' optional call handle
	Reserved(0 To 2) As LongPtr        ' reserved for ms use only
End Type
Public Type FAX_JOB_PARAMW
	SizeOfStruct As Long               ' size of this structure
	RecipientNumber As LongPtr         ' recipient fax number
	RecipientName As LongPtr           ' recipient name
	Tsid As LongPtr                    ' transmitter's id
	SenderName As LongPtr              ' sender name
	SenderCompany As LongPtr           ' sender company
	SenderDept As LongPtr              ' sender department
	BillingCode As LongPtr             ' billing code
	ScheduleAction As Long             ' when to schedule the fax, see JSA defines
	ScheduleTime As SYSTEMTIME         ' time to send the fax when JSA_SPECIFIC_TIME is used (must be local time)
	DeliveryReportType As Long         ' delivery report type, see DRT defines
	DeliveryReportAddress As LongPtr   ' email address for delivery report (ndr or dr) thru MAPI / SMTP
	DocumentName As LongPtr            ' document name (optional)
	CallHandle As Long    'HCALL       ' optional call handle
	Reserved(0 To 2) As LongPtr        ' reserved for ms use only
End Type

Public Enum WinFaxEventIDs
	FEI_DIALING = &H00000001
	FEI_SENDING = &H00000002
	FEI_RECEIVING = &H00000003
	FEI_COMPLETED = &H00000004
	FEI_BUSY = &H00000005
	FEI_NO_ANSWER = &H00000006
	FEI_BAD_ADDRESS = &H00000007
	FEI_NO_DIAL_TONE = &H00000008
	FEI_DISCONNECTED = &H00000009
	FEI_FATAL_ERROR = &H0000000a
	FEI_NOT_FAX_CALL = &H0000000b
	FEI_CALL_DELAYED = &H0000000c
	FEI_CALL_BLACKLISTED = &H0000000d
	FEI_RINGING = &H0000000e
	FEI_ABORTING = &H0000000f
	FEI_ROUTING = &H00000010
	FEI_MODEM_POWERED_ON = &H00000011
	FEI_MODEM_POWERED_OFF = &H00000012
	FEI_IDLE = &H00000013
	FEI_FAXSVC_ENDED = &H00000014
	FEI_ANSWERED = &H00000015
	FEI_JOB_QUEUED = &H00000016
	FEI_DELETED = &H00000017
	FEI_INITIALIZING = &H00000018
	FEI_LINE_UNAVAILABLE = &H00000019
	FEI_HANDLED = &H0000001a
	FEI_FAXSVC_STARTED = &H0000001b
	FEI_NEVENTS = FEI_FAXSVC_STARTED
End Enum

Public Type FAX_EVENTA
	SizeOfStruct As Long   ' Size of this structure
	TimeStamp As FILETIME  ' Timestamp for when the event was generated
	DeviceId As Long       ' Permanent line id
	EventId As WinFaxEventIDs ' Current event id
	JobId As Long          ' Fax Job Id, 0xffffffff indicates inactive job
End Type
Public Type FAX_EVENTW
	SizeOfStruct As Long   ' Size of this structure
	TimeStamp As FILETIME  ' Timestamp for when the event was generated
	DeviceId As Long       ' Permanent line id
	EventId As WinFaxEventIDs ' Current event id
	JobId As Long          ' Fax Job Id, 0xffffffff indicates inactive job
End Type

Public Type FAX_PRINT_INFOA
	SizeOfStruct As Long           ' Size of this structure
	DocName As String              ' Document name that appears in the spooler
	RecipientName As String        ' Recipient name
	RecipientNumber As String      ' Recipient fax number (non-canonical number)
	SenderName As String           ' Sender name
	SenderCompany As String        ' Sender company (optional)
	SenderDept As String           ' Sender department
	SenderBillingCode As String    ' Billing code
	Reserved As String             ' Reserved; must be NULL
	DrEmailAddress As String       ' E.Mail address for delivery report
	OutputFileName As String       ' for print to file, resulting file name
End Type
Public Type FAX_PRINT_INFOW
	SizeOfStruct As Long           ' Size of this structure
	DocName As LongPtr             ' Document name that appears in the spooler
	RecipientName As LongPtr       ' Recipient name
	RecipientNumber As LongPtr     ' Recipient fax number (non-canonical number)
	SenderName As LongPtr          ' Sender name
	SenderCompany As LongPtr       ' Sender company (optional)
	SenderDept As LongPtr          ' Sender department
	SenderBillingCode As LongPtr   ' Billing code
	Reserved As LongPtr            ' Reserved; must be NULL
	DrEmailAddress As LongPtr      ' E.Mail address for delivery report
	OutputFileName As LongPtr      ' for print to file, resulting file name
End Type

Public Type FAX_CONTEXT_INFOA
