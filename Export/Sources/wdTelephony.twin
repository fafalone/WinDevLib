    ' dwCallbackFlags As Long
    ' pfnRpfCallback As MGM_RPF_CALLBACK
    ' pfnCreationAlertCallback As MGM_CREATION_ALERT_CALLBACK
    ' pfnPruneAlertCallback As MGM_PRUNE_ALERT_CALLBACK
    ' pfnJoinAlertCallback As MGM_JOIN_ALERT_CALLBACK
    ' pfnWrongIfCallback As MGM_WRONG_IF_CALLBACK
    ' ' callbacks into Routing protocols
