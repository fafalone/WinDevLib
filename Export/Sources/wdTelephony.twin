#Region "ipxtfflt.h"

Public Type IPX_TRAFFIC_FILTER_GLOBAL_INFO
	FilterAction As IpxTrafficFilterActions ' Action if there is a match with
						 ' any filter on the interface
End Type

Public Enum IpxTrafficFilterActions
	IPX_TRAFFIC_FILTER_ACTION_PERMIT = 1
	IPX_TRAFFIC_FILTER_ACTION_DENY = 2
End Enum

Public Type IPX_TRAFFIC_FILTER_INFO
	FilterDefinition As IpxTrafficFilterFlags
	DestinationNetwork(0 To 3) As Byte
	DestinationNetworkMask(0 To 3) As Byte
	DestinationNode(0 To 5) As Byte
	DestinationSocket(0 To 1) As Byte
	SourceNetwork(0 To 3) As Byte
	SourceNetworkMask(0 To 3) As Byte
	SourceNode(0 To 5) As Byte
	SourceSocket(0 To 1) As Byte
	PacketType As Byte
End Type

Public Enum IpxTrafficFilterFlags
	IPX_TRAFFIC_FILTER_ON_SRCNET = &H00000001
	IPX_TRAFFIC_FILTER_ON_SRCNODE = &H00000002
	IPX_TRAFFIC_FILTER_ON_SRCSOCKET = &H00000004
	IPX_TRAFFIC_FILTER_ON_DSTNET = &H00000010
	IPX_TRAFFIC_FILTER_ON_DSTNODE = &H00000020
	IPX_TRAFFIC_FILTER_ON_DSTSOCKET = &H00000040
	IPX_TRAFFIC_FILTER_ON_PKTTYPE = &H00000100
	IPX_TRAFFIC_FILTER_LOG_MATCHES = &H80000000
End Enum

Public Type FLT_IF_SET_PARAMS
	InterfaceIndex As Long ' Index of the interface
	FilterAction As IpxTrafficFilterActions ' Filter action
	FilterSize As Long ' sizeof (IPX_TRAFFIC_FILTER_INFO)
End Type

Public Type FLT_IF_GET_PARAMS
	FilterAction As IpxTrafficFilterActions ' Filter action
	FilterSize As Long ' sizeof (IPX_TRAFFIC_FILTER_INFO)
	TotalSize As Long ' Total size of filter description
					' array
End Type

Public Type FLT_PACKET_LOG
	SrcIfIdx As Long ' Index of source if (-1 - unknown)
	DstIfIdx As Long ' Index of dest if (-1 - unknown)
	DataSize As Integer ' Total size of the data (at least 30)
	SeqNum As Integer ' Sequence number to account for
					' packets lost to lack of buffer space
	Header(0 To 29) As Byte ' IPX packet header followed by the
						' data if any
End Type

#End Region

#Region "RTInfo.h"

Public Type RTR_TOC_ENTRY
	InfoType As Long   ' Info structure type
	InfoSize As Long   ' Size of the info structure
	Count As Long      ' How many info structures of this type
	Offset As Long     ' Offset of the first structure, from the start
					' of the info block header.
End Type

Public Const RTR_INFO_BLOCK_VERSION  = 1

Public Type RTR_INFO_BLOCK_HEADER
	Version As Long                    ' Version of the structure
	Size As Long                       ' size of the whole block, including version
	TocEntriesCount As Long            ' Number of entries
	TocEntry(0 To 0) As RTR_TOC_ENTRY  ' Table of content followed by the actual
									' information blocks
End Type

Public Function GetInfoFromTocEntry(pInfoHdr As RTR_INFO_BLOCK_HEADER, pToc As RTR_TOC_ENTRY) As LongPtr
	Return If(pToc.Offset < pInfoHdr.Size, VarPtr(pInfoHdr) + pToc.Offset, vbNullPtr)
End Function


#End Region

#Region "ipxrtdef.h"

Public Const IPX_ROUTER_VERSION_1  = RTR_INFO_BLOCK_VERSION

[Description("NOTE: The [MS-RRASM] specification values differ from the SDK and are used in its place. IPX_PROTOCOL_RIP is entirely different from IPX_PROTOCOL_RIP in routprot.h, renamed rpIPX_PROTOCOL_RIP..")]
Public Enum IpxProtocolTypes
	IPX_PROTOCOL_LOCAL = 0
	IPX_PROTOCOL_STATIC = 1
    IPX_PROTOCOL_RIP = 2
