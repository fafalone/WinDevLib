Public Enum RasEncryptionLevels
	ET_None = 0  		' No encryption
	ET_Require = 1  	' Require Encryption
	ET_RequireMax = 2  	' Require max encryption
	ET_Optional = 3  	' Do encryption if possible. None Ok.
End Enum

Public Enum RasVSOptions
	VS_Default = 0        ' default (PPTP for now)
	VS_PptpOnly = 1       ' Only PPTP is attempted.
	VS_PptpFirst = 2      ' PPTP is tried first.
	VS_L2tpOnly = 3       ' Only L2TP is attempted.
	VS_L2tpFirst = 4      ' L2TP is tried first.
	' #if (WINVER >= 0x600)
	VS_SstpOnly = 5       ' Only SSTP is attempted
	VS_SstpFirst = 6      ' SSTP is attempted first
	' #endif
	' #if (WINVER >= 0x601)
	VS_Ikev2Only = 7      ' Only VPN Ikev2 is attempted
	VS_Ikev2First = 8     ' VPN Ikev2 is attempted first
	' #endif
	' #if (WINVER >= 0x603)
	VS_GREOnly = 9
	' #endif
	' #if (WINVER >= 0x601)
	VS_PptpSstp = 12      ' PPTP is attempted followed only by SSTP
	VS_L2tpSstp = 13      ' L2TP is attempted followed only by SSTP
	VS_Ikev2Sstp = 14     ' IKEv2 is attempted followed only by SSTP
	' #endif
	' #if (WINVER >= 0xA00)
	VS_ProtocolList = 15  ' Use ProtocolList to determine protocols to connect
	' #endif
End Enum

[Description("IMPORTANT: This is the most recent at time of writing version, for Windows 10. For earlier versions, make sure you set dwSize to the total of only the members on that OS.")]
Public Type RASENTRYA
	dwSize As Long
	dwfOptions As RasEntryOptions
	' Location/phone number.
	dwCountryID As Long
	dwCountryCode As Long
	szAreaCode(0 To RAS_MaxAreaCode) As Byte
	szLocalPhoneNumber(0 To RAS_MaxPhoneNumber) As Byte
	dwAlternateOffset As Long
	' PPP/Ip
	ipaddr As RASIPADDR
	ipaddrDns As RASIPADDR
	ipaddrDnsAlt As RASIPADDR
	ipaddrWins As RASIPADDR
	ipaddrWinsAlt As RASIPADDR
	' Framing
	dwFrameSize As Long
	dwfNetProtocols As RasNetworkProtocols
	dwFramingProtocol As RasFramingProtocols
	' Scripting
	szScript(0 To (MAX_PATH - 1)) As Byte
	' AutoDial
	szAutodialDll(0 To (MAX_PATH - 1)) As Byte
	szAutodialFunc(0 To (MAX_PATH - 1)) As Byte
	' Device
	szDeviceType(0 To RAS_MaxDeviceType) As Byte
	szDeviceName(0 To RAS_MaxDeviceName) As Byte
	' X.25
	szX25PadType(0 To RAS_MaxPadType) As Byte
	szX25Address(0 To RAS_MaxX25Address) As Byte
	szX25Facilities(0 To RAS_MaxFacilities) As Byte
	szX25UserData(0 To RAS_MaxUserData) As Byte
	dwChannels As Long
	' Reserved
	dwReserved1 As Long
	dwReserved2 As Long
	'#if (WINVER >= 0x401)
	' Multilink
	dwSubEntries As Long
	dwDialMode As RasDialModes
	dwDialExtraPercent As Long
	dwDialExtraSampleSeconds As Long
	dwHangUpExtraPercent As Long
	dwHangUpExtraSampleSeconds As Long
	' Idle timeout
	dwIdleDisconnectSeconds As RasIdleDisconnectDefaults
	'#endif
	'#if (WINVER >= 0x500)
	' Entry Type
	dwType As RasPhonebookEntryTypes
	' Encryption type
	dwEncryptionType As RasEncryptionLevels
	' CustomAuthKey to be used for EAP
	dwCustomAuthKey As Long
	' Guid of the connection
	guidId As UUID
	' Custom Dial Dll
	szCustomDialDll(0 To (MAX_PATH - 1)) As Byte
	' DwVpnStrategy
	dwVpnStrategy As RasVSOptions
	'#endif
	'#if (WINVER >= 0x501)
	' More RASEO_* options
	dwfOptions2 As RasEntryOptions2
	' For future use
	dwfOptions3 As Long
	szDnsSuffix(0 To (RAS_MaxDnsSuffix - 1)) As Byte
	dwTcpWindowSize As Long
	szPrerequisitePbk(0 To (MAX_PATH - 1)) As Byte
	szPrerequisiteEntry(0 To RAS_MaxEntryName) As Byte
	dwRedialCount As Long
	dwRedialPause As Long
	'#endif
	'#if (WINVER >= 0x600)
	' PPP/IPv6
	ipv6addrDns As RASIPV6ADDR
	ipv6addrDnsAlt As RASIPV6ADDR
	dwIPv4InterfaceMetric As Long
	dwIPv6InterfaceMetric As Long
	'#endif
	'#if (WINVER >= 0x601)
	' Fields required for supporting static IPv6 address
	' configuration for a vpn interface by the user
	ipv6addr As RASIPV6ADDR
	dwIPv6PrefixLength As Long
	' IKEv2 related
	dwNetworkOutageTime As Long
	'#endif
	'#if (WINVER >= 0xA00)
	szIDi(0 To RAS_MaxIDSize) As Byte
	szIDr(0 To RAS_MaxIDSize) As Byte
	fIsImsConfig As BOOL
	IdiType As IKEV2_ID_PAYLOAD_TYPE
	IdrType As IKEV2_ID_PAYLOAD_TYPE
	fDisableIKEv2Fragmentation As BOOL
	'#endif
End Type
[Description("IMPORTANT: This is the most recent at time of writing version, for Windows 10. For earlier versions, make sure you set dwSize to the total of only the members on that OS.")]
