Public Function TAPIERROR_FORMATMESSAGE(ByVal ErrCode As Long) As Long
    Dim uErrCode As LongLong
    uErrCode = ErrCode
    uErrCode = uErrCode And &HFFFFFFFF^

    Dim uResult As LongLong
    If uErrCode > &HFFFF0000^ Then
        uResult = uErrCode And &HFFFF&
    ElseIf (uErrCode And &H10000000^) <> 0 Then
        uResult = uErrCode - &H90000000^ + &HF000&
    Else
        uResult = uErrCode - &H80000000^ + &HE000&
    End If

    Dim lResult As Long
    CopyMemory lResult, uResult, 4
    Return lResult
End Function
#End Region


#Region "WinFax.h"

Public Enum WinFaxErrors
	FAX_ERR_START = 7001  ' First fax specific error code
	FAX_ERR_SRV_OUTOFMEMORY = 7001
	FAX_ERR_GROUP_NOT_FOUND = 7002
	FAX_ERR_BAD_GROUP_CONFIGURATION = 7003
	FAX_ERR_GROUP_IN_USE = 7004
	FAX_ERR_RULE_NOT_FOUND = 7005
	FAX_ERR_NOT_NTFS = 7006
	FAX_ERR_DIRECTORY_IN_USE = 7007
	FAX_ERR_FILE_ACCESS_DENIED = 7008
	FAX_ERR_MESSAGE_NOT_FOUND = 7009
	FAX_ERR_DEVICE_NUM_LIMIT_EXCEEDED = 7010
	FAX_ERR_NOT_SUPPORTED_ON_THIS_SKU = 7011
	FAX_ERR_VERSION_MISMATCH = 7012  ' Fax client/server versions mismtach
	FAX_ERR_RECIPIENTS_LIMIT = 7013  ' Recipients limit in a single broadcast
	FAX_ERR_END = 7013  ' Last fax specific error code
End Enum

[Description(" The fax server failed to allocate memory.")] Public Const FAX_E_SRV_OUTOFMEMORY = &H80041B59 ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_SRV_OUTOFMEMORY
[Description(" The fax server failed to locate an outbound routing group by name.")] Public Const FAX_E_GROUP_NOT_FOUND = &H80041B5A ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_GROUP_NOT_FOUND)
[Description(" The fax server encountered an outbound routing group with bad configuration.")] Public Const FAX_E_BAD_GROUP_CONFIGURATION = &H80041B5B ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_BAD_GROUP_CONFIGURATION)
[Description(" The fax server cannot remove an outbound routing group because it is in use by one or more outbound routing rules.")] Public Const FAX_E_GROUP_IN_USE = &H80041B5C ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_GROUP_IN_USE)
[Description(" The fax server failed to locate an outbound routing rule by country/region code and area code.")] Public Const FAX_E_RULE_NOT_FOUND = &H80041B5D 'MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_RULE_NOT_FOUND)
[Description(" The fax server cannot set an archive folder to a non-NTFS partition.")] Public Const FAX_E_NOT_NTFS = &H80041B5E 'MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_NOT_NTFS)
[Description(" The fax server cannot use the same folder for both the inbox and the sent-items archives.")] Public Const FAX_E_DIRECTORY_IN_USE = &H80041B5F ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_DIRECTORY_IN_USE)
[Description(" The fax server cannot access the specified file or folder.")] Public Const FAX_E_FILE_ACCESS_DENIED = &H80041B60 ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_FILE_ACCESS_DENIED)
[Description(" The fax server cannot find the job or message by its ID.")] Public Const FAX_E_MESSAGE_NOT_FOUND = &H80041B61 ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_MESSAGE_NOT_FOUND
[Description(" The fax server cannot complete the operation because the number of active fax devices allowed for this version of Windows was exceeded.")] Public Const FAX_E_DEVICE_NUM_LIMIT_EXCEEDED = &H80041B62 ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_DEVICE_NUM_LIMIT_EXCEEDED
[Description(" The fax server cannot complete the operation because it is not supported for this version of Windows.")] Public Const FAX_E_NOT_SUPPORTED_ON_THIS_SKU = &H80041B63 ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_NOT_SUPPORTED_ON_THIS_SKU
[Description(" The fax server API version does not support the requested operation.")] Public Const FAX_E_VERSION_MISMATCH = &H80041B64 ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_VERSION_MISMATCH
[Description("The limit on the number of recipients for a single fax broadcast was reached.")] Public Const FAX_E_RECIPIENTS_LIMIT = &H80041B65 ' MAKE_HRESULT(SEVERITY_ERROR, FACILITY_ITF, FAX_ERR_RECIPIENTS_LIMIT

Public Enum FAX_ENUM_LOG_LEVELS
	FAXLOG_LEVEL_NONE = 0
	FAXLOG_LEVEL_MIN
	FAXLOG_LEVEL_MED
	FAXLOG_LEVEL_MAX
End Enum

Public Enum FAX_ENUM_LOG_CATEGORIES
	FAXLOG_CATEGORY_INIT = 1   ' Initialization / shutdown
	FAXLOG_CATEGORY_OUTBOUND   ' Outbound messages
	FAXLOG_CATEGORY_INBOUND    ' Inbound messages
	FAXLOG_CATEGORY_UNKNOWN    ' Unknown category (all others)
End Enum

Public Type FAX_LOG_CATEGORYA
	Name As String   ' logging category name
	Category As Long ' logging category number
	Level As Long    ' logging level for the category
End Type
Public Type FAX_LOG_CATEGORYW
	Name As LongPtr   ' logging category name
	Category As Long  ' logging category number
	Level As Long     ' logging level for the category
End Type

Public Type FAX_TIME
	Hour As Integer
	Minute As Integer
End Type

Public Type FAX_CONFIGURATIONA
	SizeOfStruct As Long           ' size of this structure
	Retries As Long                ' number of retries for fax send
	RetryDelay As Long             ' number of minutes between retries
	DirtyDays As Long              ' number of days to keep an unsent job in the queue
	Branding As BOOL               ' fsp should brand outgoing faxes
	UseDeviceTsid As BOOL          ' server uses device tsid only
	ServerCp As BOOL               ' clients must use cover pages on the server
	PauseServerQueue As BOOL       ' is the server queue paused?
	StartCheapTime As FAX_TIME     ' start of discount rate period
	StopCheapTime As FAX_TIME      ' end of discount rate period
	ArchiveOutgoingFaxes As BOOL   ' whether outgoing faxes should be archived
	ArchiveDirectory As String     ' archive directory for outgoing faxes
	Reserved As String             ' Reserved; must be NULL
End Type
Public Type FAX_CONFIGURATIONW
	SizeOfStruct As Long           ' size of this structure
	Retries As Long                ' number of retries for fax send
	RetryDelay As Long             ' number of minutes between retries
	DirtyDays As Long              ' number of days to keep an unsent job in the queue
	Branding As BOOL               ' fsp should brand outgoing faxes
	UseDeviceTsid As BOOL          ' server uses device tsid only
	ServerCp As BOOL               ' clients must use cover pages on the server
	PauseServerQueue As BOOL       ' is the server queue paused?
	StartCheapTime As FAX_TIME     ' start of discount rate period
	StopCheapTime As FAX_TIME      ' end of discount rate period
	ArchiveOutgoingFaxes As BOOL   ' whether outgoing faxes should be archived
	ArchiveDirectory As LongPtr    ' archive directory for outgoing faxes
	Reserved As LongPtr            ' Reserved; must be NULL
End Type

Public Enum FAX_ENUM_JOB_COMMANDS
	JC_UNKNOWN = 0
	JC_DELETE
	JC_PAUSE
	JC_RESUME
    JC_RESTART = JC_RESUME
End Enum

Public Enum WinFaxJobTypes
	JT_UNKNOWN = 0
	JT_SEND = 1
	JT_RECEIVE = 2
	JT_ROUTING = 3
	JT_FAIL_RECEIVE = 4
End Enum

Public Enum WinFaxJobStatus
	JS_PENDING = &H00000000
	JS_INPROGRESS = &H00000001
	JS_DELETING = &H00000002
	JS_FAILED = &H00000004
	JS_PAUSED = &H00000008
	JS_NOLINE = &H00000010
	JS_RETRYING = &H00000020
	JS_RETRIES_EXCEEDED = &H00000040
End Enum

Public Type FAX_DEVICE_STATUSA
	SizeOfStruct As Long       ' size of this structure
	CallerId As String         ' caller id string
	Csid As String             ' station identifier
	CurrentPage As Long        ' current page
	DeviceId As Long           ' permanent line id
	DeviceName As String       ' device name
	DocumentName As String     ' document name
	JobType As WinFaxJobTypes  ' send or receive?
	PhoneNumber As String      ' sending phone number
	RoutingString As String    ' routing information
	SenderName As String       ' sender name
	RecipientName As String    ' recipient name
	Size As Long               ' size in bytes of the document
	StartTime As FILETIME      ' starting time of the fax send/receive
	Status As Long             ' current status of the device, see FPS_??? masks
	StatusString As String     ' status string if the Status field is zero.  this may be NULL.
	SubmittedTime As FILETIME  ' time the document was submitted
	TotalPages As Long         ' total number of pages in this job
	Tsid As String             ' transmitting station identifier
	UserName As String         ' user that submitted the active job
End Type
Public Type FAX_DEVICE_STATUSW
	SizeOfStruct As Long       ' size of this structure
	CallerId As LongPtr        ' caller id string
	Csid As LongPtr            ' station identifier
	CurrentPage As Long        ' current page
	DeviceId As Long           ' permanent line id
	DeviceName As LongPtr      ' device name
	DocumentName As LongPtr    ' document name
	JobType As WinFaxJobTypes  ' send or receive?
	PhoneNumber As LongPtr     ' sending phone number
	RoutingString As LongPtr   ' routing information
	SenderName As LongPtr      ' sender name
	RecipientName As LongPtr   ' recipient name
	Size As Long               ' size in bytes of the document
	StartTime As FILETIME      ' starting time of the fax send/receive
	Status As Long             ' current status of the device, see FPS_??? masks
	StatusString As LongPtr    ' status string if the Status field is zero.  this may be NULL.
	SubmittedTime As FILETIME  ' time the document was submitted
	TotalPages As Long         ' total number of pages in this job
	Tsid As LongPtr            ' transmitting station identifier
	UserName As LongPtr        ' user that submitted the active job
End Type

Public Type FAX_JOB_ENTRYA
	SizeOfStruct As Long               ' size of this structure
	JobId As Long                      ' fax job id
	UserName As String                 ' user who submitted the job
	JobType As WinFaxJobTypes          ' job type, see JT defines
	QueueStatus As WinFaxJobStatus	   ' job queue status, see JS defines
	Status As WinFaxPortStates         ' current status of the device, see FPS_??? masks
	Size As Long                       ' size in bytes of the document
	PageCount As Long                  ' total page count
	RecipientNumber As String          ' recipient fax number
	RecipientName As String            ' recipient name
	Tsid As String                     ' transmitter's id
	SenderName As String               ' sender name
	SenderCompany As String            ' sender company
	SenderDept As String               ' sender department
	BillingCode As String              ' billing code
	ScheduleAction As Long             ' when to schedule the fax, see JSA defines
	ScheduleTime As SYSTEMTIME         ' time to send the fax when JSA_SPECIFIC_TIME is used (must be local time)
	DeliveryReportType As Long         ' delivery report type, see DRT defines
	DeliveryReportAddress As String    ' email address for delivery report (ndr or dr) thru MAPI / SMTP
	DocumentName As String             ' document name
End Type
Public Type FAX_JOB_ENTRYW
	SizeOfStruct As Long               ' size of this structure
	JobId As Long                      ' fax job id
	UserName As LongPtr                ' user who submitted the job
	JobType As WinFaxJobTypes          ' job type, see JT defines
	QueueStatus As WinFaxJobStatus     ' job queue status, see JS defines
	Status As WinFaxPortStates         ' current status of the device, see FPS_??? masks
	Size As Long                       ' size in bytes of the document
	PageCount As Long                  ' total page count
	RecipientNumber As LongPtr         ' recipient fax number
	RecipientName As LongPtr           ' recipient name
	Tsid As LongPtr                    ' transmitter's id
	SenderName As LongPtr              ' sender name
	SenderCompany As LongPtr           ' sender company
	SenderDept As LongPtr              ' sender department
	BillingCode As LongPtr             ' billing code
	ScheduleAction As Long             ' when to schedule the fax, see JSA defines
	ScheduleTime As SYSTEMTIME         ' time to send the fax when JSA_SPECIFIC_TIME is used (must be local time)
	DeliveryReportType As Long         ' delivery report type, see DRT defines
	DeliveryReportAddress As LongPtr   ' email address for delivery report (ndr or dr) thru MAPI / SMTP
	DocumentName As LongPtr            ' document name
End Type

Public Enum WinFaxPortStates
	FPS_DIALING = &H20000001
	FPS_SENDING = &H20000002
	FPS_RECEIVING = &H20000004
	FPS_COMPLETED = &H20000008
	FPS_HANDLED = &H20000010
	FPS_UNAVAILABLE = &H20000020
	FPS_BUSY = &H20000040
	FPS_NO_ANSWER = &H20000080
	FPS_BAD_ADDRESS = &H20000100
	FPS_NO_DIAL_TONE = &H20000200
	FPS_DISCONNECTED = &H20000400
	FPS_FATAL_ERROR = &H20000800
	FPS_NOT_FAX_CALL = &H20001000
	FPS_CALL_DELAYED = &H20002000
	FPS_CALL_BLACKLISTED = &H20004000
	FPS_INITIALIZING = &H20008000
	FPS_OFFLINE = &H20010000
	FPS_RINGING = &H20020000
	FPS_AVAILABLE = &H20100000
	FPS_ABORTING = &H20200000
	FPS_ROUTING = &H20400000
	FPS_ANSWERED = &H20800000
End Enum

Public Enum WinFaxPortCaps
	FPF_RECEIVE = &H00000001  ' Automatically receive faxes
	FPF_SEND = &H00000002
	FPF_VIRTUAL = &H00000004
End Enum

Public Type FAX_PORT_INFOA
	SizeOfStruct As Long   ' size of this structure
	DeviceId As Long       ' Device ID
	State As WinFaxPortStates ' State of the device
	Flags As WinFaxPortCaps   ' Device specific flags
	Rings As Long          ' Number of rings before answer
	Priority As Long       ' Device priority
