Public Delegate Function PDISCONNECT_CLIENT (ByVal InterfaceIndex As Long, ByVal ClientAddress As LongPtr) As Long

Public Enum RtIfaceFlags
	MRINFO_TUNNEL_FLAG = &H01
	MRINFO_PIM_FLAG = &H04
	MRINFO_DOWN_FLAG = &H10
	MRINFO_DISABLED_FLAG = &H20
	MRINFO_QUERIER_FLAG = &H40
	MRINFO_LEAF_FLAG = &H80
End Enum

Public Delegate Function PGET_NEIGHBORS (ByVal InterfaceIndex As Long, NeighborList As Long, ByRef NeighborListSize As Long, ByVal InterfaceFlags As LongPtr) As Long

Public Const MFE_NO_ERROR  = 0  ' none of the below events
Public Const MFE_REACHED_CORE  = 1  ' this router is an RP/core for the group
'  StatusCode values set by oif owner only
Public Const MFE_OIF_PRUNED  = 5  ' no downstream receivers exist on oif
'  StatusCode values set by iif owner only
Public Const MFE_PRUNED_UPSTREAM  = 4  ' a prune was send upstream
Public Const MFE_OLD_ROUTER  = 11  ' upstream nbr doesn't support mtrace
'  StatusCode values which are used only by the Router Manager itself:
Public Const MFE_NOT_FORWARDING  = 2  ' not fwding for an unspecified reason
Public Const MFE_WRONG_IF  = 3  ' mtrace received on iif
Public Const MFE_BOUNDARY_REACHED  = 6  ' iif or oif is admin scope boundary
Public Const MFE_NO_MULTICAST  = 7  ' oif is not multicast-enabled
Public Const MFE_IIF  = 8  ' mtrace arrived on iif
Public Const MFE_NO_ROUTE  = 9  ' router has no route that matches
Public Const MFE_NOT_LAST_HOP  = 10  ' router is not the proper last-hop router
Public Const MFE_PROHIBITED  = 12  ' mtrace is administratively prohibited
Public Const MFE_NO_SPACE  = 13  ' not enough room in packet


