	hDC As LongPtr                                              ' Device Context
	ServerName(0 To (MAX_COMPUTERNAME_LENGTH)) As Byte  ' Server name
End Type
Public Type FAX_CONTEXT_INFOW
	SizeOfStruct As Long                                           ' Size of this structure
	hDC As LongPtr                                                 ' Device Context
	ServerName(0 To (MAX_COMPUTERNAME_LENGTH)) As Integer    ' Server name
End Type

