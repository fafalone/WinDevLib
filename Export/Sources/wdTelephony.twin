    dwTcpWindowSize As Long
    szPrerequisitePbk(0 To (MAX_PATH - 1)) As Integer
    szPrerequisiteEntry(0 To RAS_MaxEntryName) As Integer
    dwRedialCount As Long
    dwRedialPause As Long
    '#endif
    '#if (WINVER >= 0x600)
    ' PPP/IPv6
    ipv6addrDns As RASIPV6ADDR
    ipv6addrDnsAlt As RASIPV6ADDR
    dwIPv4InterfaceMetric As Long
    dwIPv6InterfaceMetric As Long
    '#endif
    '#if (WINVER >= 0x601)
    ' Fields required for supporting static IPv6 address
    ' configuration for a vpn interface by the user
    ipv6addr As RASIPV6ADDR
    dwIPv6PrefixLength As Long
    ' IKEv2 related
    dwNetworkOutageTime As Long
    '#endif
    '#if (WINVER >= 0xA00)
    szIDi(0 To RAS_MaxIDSize) As Integer
    szIDr(0 To RAS_MaxIDSize) As Integer
    fIsImsConfig As BOOL
    IdiType As IKEV2_ID_PAYLOAD_TYPE
    IdrType As IKEV2_ID_PAYLOAD_TYPE
    fDisableIKEv2Fragmentation As BOOL
    '#endif
End Type

