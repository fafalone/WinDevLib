Public Function RASCF_IsOwner(ByVal rascFlags As RasOwnerFlags) As Boolean
    Return ((rascFlags And (RASCF_OwnerKnown Or RASCF_OwnerMatch)) = (RASCF_OwnerKnown Or RASCF_OwnerMatch))
End Function

Public Function RASCF_IsNotOwner(ByVal rascFlags As RasOwnerFlags) As Boolean
    Return ((rascFlags And (RASCF_OwnerKnown Or RASCF_OwnerMatch)) = RASCF_OwnerKnown)
End Function

