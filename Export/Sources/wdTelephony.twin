#Region "mgm.h"

Public Type MGM_IF_ENTRY
	dwIfIndex As Long
	dwIfNextHopAddr As Long
	bIGMP As BOOL
	bIsEnabled As BOOL
End Type

Public Delegate Function MGM_RPF_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByRef pdwInIfIndex As Long, ByRef pdwInIfNextHopAddr As Long, ByRef pdwUpStreamNbr As Long, ByVal dwHdrSize As Long, ByVal pbPacketHdr As LongPtr, ByVal pbRoute As LongPtr) As Long
Public Delegate Function MGM_CREATION_ALERT_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwInIfIndex As Long, ByVal dwInIfNextHopAddr As Long, ByVal dwIfCount As Long, ByRef pmieOutIfList As MGM_IF_ENTRY) As Long
Public Delegate Function MGM_PRUNE_ALERT_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long, ByVal bMemberDelete As BOOL, ByRef pdwTimeout As Long) As Long
Public Delegate Function MGM_JOIN_ALERT_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal bMemberUpdate As BOOL) As Long
Public Delegate Function MGM_WRONG_IF_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwGroupAddr As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long, ByVal dwHdrSize As Long, ByVal pbPacketHdr As LongPtr) As Long
Public Delegate Function MGM_LOCAL_JOIN_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
Public Delegate Function MGM_LOCAL_LEAVE_CALLBACK (ByVal dwSourceAddr As Long, ByVal dwSourceMask As Long, ByVal dwGroupAddr As Long, ByVal dwGroupMask As Long, ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
Public Delegate Function MGM_DISABLE_IGMP_CALLBACK (ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long
Public Delegate Function MGM_ENABLE_IGMP_CALLBACK (ByVal dwIfIndex As Long, ByVal dwIfNextHopAddr As Long) As Long

' #If WDL_NO_DELEGATES Then
Public Type ROUTING_PROTOCOL_CONFIG
	dwCallbackFlags As Long
	pfnRpfCallback As LongPtr 'MGM_RPF_CALLBACK
	pfnCreationAlertCallback As LongPtr 'MGM_CREATION_ALERT_CALLBACK
	pfnPruneAlertCallback As LongPtr 'MGM_PRUNE_ALERT_CALLBACK
	pfnJoinAlertCallback As LongPtr 'MGM_JOIN_ALERT_CALLBACK
	pfnWrongIfCallback As LongPtr 'MGM_WRONG_IF_CALLBACK
	' callbacks into Routing protocols
	pfnLocalJoinCallback As LongPtr 'MGM_LOCAL_JOIN_CALLBACK
	pfnLocalLeaveCallback As LongPtr 'MGM_LOCAL_LEAVE_CALLBACK
	' callbacks into IGMP
	pfnDisableIgmpCallback As LongPtr 'MGM_DISABLE_IGMP_CALLBACK
	pfnEnableIgmpCallback As LongPtr 'MGM_ENABLE_IGMP_CALLBACK
End Type
' #Else
