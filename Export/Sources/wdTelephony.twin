Public Type SECURITY_MESSAGE
	dwMsgId As Long
	hPort As LongPtr 'HPORT
	dwError As Long                        ' Should be non-zero only if error
										   ' occurred during the security dialog.
										   ' Should contain errors from winerror.h
										   ' or raserror.h
	UserName(0 To UNLEN) As Byte 		   ' Should always contain username if
										   ' dwMsgId is SUCCESS/FAILURE
	Domain(0 To DNLEN) As Byte     		   ' Should always contain domain if
										   ' dwMsgId is SUCCESS/FAILURE
End Type

Public Enum RasSecurityMsgIDs
	SECURITYMSG_SUCCESS = 1
	SECURITYMSG_FAILURE = 2
	SECURITYMSG_ERROR = 3
End Enum

Public Type RAS_SECURITY_INFO
    LastError As Long       ' SUCCESS = receive completed
                            ' PENDING = receive pending
                            ' else completed with error
    BytesReceived As Long   ' only valid if LastError == SUCCESS
    DeviceName(0 To MAX_DEVICE_NAME) As Byte
End Type

