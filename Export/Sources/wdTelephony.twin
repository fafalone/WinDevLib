#Region "ipxconst.h"

Public Enum IpxAdminStates
	ADMIN_STATE_DISABLED = 1
	ADMIN_STATE_ENABLED = 2
    ADMIN_STATE_ENABLED_ONLY_FOR_NETBIOS_STATIC_ROUTING = 3
    ADMIN_STATE_ENABLED_ONLY_FOR_OPER_STATE_UP = 4
End Enum

Public Enum IpxOperationalStates
	OPER_STATE_DOWN = 1  ' not operational
	OPER_STATE_UP = 2  ' operational & can pass packets
	OPER_STATE_SLEEPING = 3  ' operational but has to connect to pass packets
	'  Additional operational states in starting/stopping the router
	OPER_STATE_STARTING = 4
	OPER_STATE_STOPPING = 5
End Enum

Public Enum IpxUpdateModes
	IPX_STANDARD_UPDATE = 1  ' Periodic update, every UpdateInterval
	IPX_NO_UPDATE = 2  ' No update, used for static routes config
	IPX_AUTO_STATIC_UPDATE = 3  ' AutoStatic triggered update        5
End Enum

Public Enum IpxPacketTypes
	IPX_STANDARD_PACKET_TYPE = 1
	IPX_RELIABLE_DELIVERY_PACKET_TYPE = 2
End Enum

Public Const IPX_PACE_DEFVAL  = 18  ' This corresponds to a 55 ms interpacketgap
'  UpdateInterval definitions
Public Const IPX_UPDATE_INTERVAL_DEFVAL  = 60

