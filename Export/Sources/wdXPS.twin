        XPS_SIGNATURE_STATUS_INCOMPLETE = 2
        XPS_SIGNATURE_STATUS_BROKEN = 3
        XPS_SIGNATURE_STATUS_QUESTIONABLE = 4
        XPS_SIGNATURE_STATUS_VALID = 5
    End Enum
    
    Public Enum XPS_SIGN_POLICY
        XPS_SIGN_POLICY_NONE = &H00
        XPS_SIGN_POLICY_CORE_PROPERTIES = &H01
        XPS_SIGN_POLICY_SIGNATURE_RELATIONSHIPS = &H02
        XPS_SIGN_POLICY_PRINT_TICKET = &H04
        XPS_SIGN_POLICY_DISCARD_CONTROL = &H08
        XPS_SIGN_POLICY_ALL = &H0F
    End Enum
    
