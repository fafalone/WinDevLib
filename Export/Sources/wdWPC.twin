[InterfaceId("50B6A267-C4BD-450b-ADB5-759073837C9E")]
[OleAutomation(False)]
Interface IWPCProviderState Extends IUnknown
    Sub Enable()
    Sub Disable()
End Interface

[InterfaceId("BEF54196-2D02-4a26-B6E5-D65AF295D0F1")]
[OleAutomation(False)]
Interface IWPCProviderConfig Extends IUnknown
    Sub GetUserSummary(ByVal bstrSID As String, ByRef pbstrUserSummary As String)
    Sub Configure(ByVal hWnd As LongPtr, ByVal bstrSID As String)
    Sub RequestOverride(ByVal hWnd As LongPtr, ByVal bstrPath As String, ByVal dwFlags As WPCFLAG_OVERRIDE)
End Interface

[InterfaceId("8FDF6CA1-0189-47e4-B670-1A8A4636E340")]
[OleAutomation(False)]
Interface IWPCSettings Extends IUnknown
    Sub IsLoggingRequired(ByRef pfRequired As BOOL)
    Sub GetLastSettingsChangeTime(ByRef pTime As SYSTEMTIME)
    Sub GetRestrictions(ByRef pdwRestrictions As WPCFLAG_RESTRICTION)
End Interface

[InterfaceId("95E87780-E158-489e-B452-BBB850790715")]
[OleAutomation(False)]
Interface IWPCGamesSettings Extends IWPCSettings
    Sub IsBlocked(ByVal guidAppID As UUID, ByRef pdwReasons As Long)
End Interface

[InterfaceId("FFCCBDB8-0992-4c30-B0F1-1CBB09C240AA")]
[OleAutomation(False)]
Interface IWPCWebSettings Extends IWPCSettings
    Sub GetSettings(ByRef pdwSettings As WPCFLAG_WEB_SETTING)
    Sub RequestURLOverride(ByVal hWnd As LongPtr, ByVal pcszURL As LongPtr, ByVal cURLs As Long, ByRef ppcszSubURLs As LongPtr, ByRef pfChanged As BOOL)
End Interface

[InterfaceId("4FF40A0F-3F3B-4d7c-A41B-4F39D7B44D05")]
[OleAutomation(False)]
Interface IWindowsParentalControlsCore Extends IUnknown
    Sub GetVisibility(ByRef peVisibility As WPCFLAG_VISIBILITY)
    Sub GetUserSettings(ByVal pcszSID As LongPtr, ByRef ppSettings As IWPCSettings)
    Sub GetWebSettings(ByVal pcszSID As LongPtr, ByRef ppSettings As IWPCWebSettings)
    Sub GetWebFilterInfo(ByRef pguidID As UUID, ByRef ppszName As LongPtr)
End Interface

[InterfaceId("28B4D88B-E072-49e6-804D-26EDBE21A7B9")]
[OleAutomation(False)]
Interface IWindowsParentalControls Extends IWindowsParentalControlsCore
    Sub GetGamesSettings(ByVal pcszSID As LongPtr, ByRef ppSettings As IWPCGamesSettings)
End Interface

[InterfaceId("41EBA572-23ED-4779-BEC1-8DF96206C44C")]
[OleAutomation(False)]
Interface IWPCProviderSupport Extends IUnknown
    Sub GetCurrent(ByRef pguidProvider As UUID)
End Interface



