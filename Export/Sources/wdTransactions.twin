Public Const PROPID_M_MSGID_SIZE  = 20
Public Const PROPID_M_CORRELATIONID_SIZE  = 20
Public Const PROPID_M_XACTID_SIZE  = 20

Public Function MQCLASS_CODE(s As Long, r As Long, code As Long) As Long
    Return ((s << 15) Or (r << 14) Or code) And &HFFFF&
End Function

Public Function MQCLASS_NACK(c As Long) As Long
    Return c And &H8000&
End Function

Public Function MQCLASS_RECEIVE(c As Long) As Long
    Return c And &H4000&
End Function

Public Function MQCLASS_NACK_HTTP(c As Long) As BOOL
    Return If((c And &HA000&) = &HA000&, CTRUE, CFALSE)
End Function

 
Public Const MQMSG_CLASS_NORMAL = &H0 ' MQCLASS_CODE(0, 0, 0x00)
Public Const MQMSG_CLASS_ACK_REACH_QUEUE = &H2 ' MQCLASS_CODE(0, 0, 0x02)
