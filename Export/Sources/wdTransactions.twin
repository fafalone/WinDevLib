Public Function MQ_QTYPE_REPORT() As UUID
'{55EE8F32-CCE9-11cf-B108-0020AFD61CE9}
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H55EE8F32, CInt(&HCCE9), CInt(&H11cf), &HB1, &H08, &H00, &H20, &HAF, &HD6, &H1C, &HE9)
 MQ_QTYPE_REPORT = iid
End Function
Public Function MQ_QTYPE_TEST() As UUID
'{55EE8F33-CCE9-11cf-B108-0020AFD61CE9}
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H55EE8F33, CInt(&HCCE9), CInt(&H11cf), &HB1, &H08, &H00, &H20, &HAF, &HD6, &H1C, &HE9)
 MQ_QTYPE_TEST = iid
End Function

