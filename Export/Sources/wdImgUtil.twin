[InterfaceId("3050f2f1-98b5-11cf-bb82-00aa00bdce0b")]
[OleAutomation(False)]
Interface IViewFilter Extends IUnknown
	Sub SetSource(ByVal pFilter As IViewFilter)
	Sub GetSource(ByRef ppFilter As IViewFilter)
	Sub SetSite(ByVal pSink As IViewFilterSite)
	Sub GetSite(ByRef ppSink As IViewFilterSite)
	Sub SetPosition(ByRef prc As RECT)
	Sub Draw(ByVal hdc As LongPtr, ByRef prcBounds As RECT)
	Sub GetStatusBits(ByRef pdwFlags As OcmmStatusBits)
End Interface

[InterfaceId("3050f372-98b5-11cf-bb82-00aa00bdce0b")]
[OleAutomation(False)]
Interface IViewTransition Extends IViewFilter
	Sub Initialize(ByVal hdc As LongPtr, ByRef prc As RECT)
	Sub Go(ByVal vtimeDuration As Variant)
End Interface

[InterfaceId("3050f2f4-98b5-11cf-bb82-00aa00bdce0b")]
[OleAutomation(False)]
Interface IViewFilterSite Extends IUnknown
	Sub GetDC(ByRef prc As RECT, ByVal dwFlags As Long, ByRef phdc As LongPtr)
	Sub ReleaseDC(ByVal hdc As LongPtr)
	Sub InvalidateRect(ByRef prc As RECT, ByVal fErase As BOOL)
	Sub InvalidateRgn(ByVal hrgn As LongPtr, ByVal fErase As BOOL)
	Sub OnStatusBitsChange(ByVal dwFlags As OcmmStatusBits)
End Interface

[InterfaceId("3050f373-98b5-11cf-bb82-00aa00bdce0b")]
[OleAutomation(False)]
Interface IViewTransitionSite Extends IViewFilterSite
	Sub OnComplete()
End Interface

[InterfaceId("3050f35f-98b5-11cf-bb82-00aa00bdce0b")]
