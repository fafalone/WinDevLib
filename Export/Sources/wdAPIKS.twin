    [PackingAlignment(1)]
    Public Type WAVEFORMATEXTENSIBLE_IEC61937
        FormatExt As WAVEFORMATEXTENSIBLE  /* Format of encoded data as it is */
                                           /* intended to be streamed over the link */
        dwEncodedSamplesPerSec As Long     /* Sampling rate of the post-decode audio. */
        dwEncodedChannelCount As Long      /* Channel count of the post-decode audio. */
        dwAverageBytesPerSec As Long       /* Byte rate of the content, can be 0. */
    End Type
    
    [PackingAlignment(1)]
    Public Type KSDATAFORMAT_WAVEFORMATEXTENSIBLE
        DataFormat As KSDATAFORMAT
        WaveFormatExt As WAVEFORMATEXTENSIBLE
    End Type
    
