Public Enum KsAllocFlags
    KSALLOCATOR_OPTIONF_COMPATIBLE = &H00000001
    KSALLOCATOR_OPTIONF_SYSTEM_MEMORY = &H00000002
    KSALLOCATOR_OPTIONF_VALID = &H00000003
    '  pins extended framing flags
    KSALLOCATOR_FLAG_PARTIAL_READ_SUPPORT = &H00000010
    KSALLOCATOR_FLAG_DEVICE_SPECIFIC = &H00000020
    KSALLOCATOR_FLAG_CAN_ALLOCATE = &H00000040
    KSALLOCATOR_FLAG_INSIST_ON_FRAMESIZE_RATIO = &H00000080
    '  allocator pipes flags
    '  there is at least one data modification in a pipe
    KSALLOCATOR_FLAG_NO_FRAME_INTEGRITY = &H00000100
    KSALLOCATOR_FLAG_MULTIPLE_OUTPUT = &H00000200
    KSALLOCATOR_FLAG_CYCLE = &H00000400
    KSALLOCATOR_FLAG_ALLOCATOR_EXISTS = &H00000800
    '  there is no framing dependency between neighbouring pipes.
    KSALLOCATOR_FLAG_INDEPENDENT_RANGES = &H00001000
    KSALLOCATOR_FLAG_ATTENTION_STEPPING = &H00002000
    KSALLOCATOR_FLAG_ENABLE_CACHED_MDL = &H00004000
    KSALLOCATOR_FLAG_2D_BUFFER_REQUIRED = &H00008000&
End Enum

Public Type KSALLOCATOR_FRAMING
    '    union {
    '        ULONG       OptionsFlags;       // allocator options (create)
    '        ULONG       RequirementsFlags;  // allocation requirements (query)
    '    };
    OptionsFlags As KsAllocFlags
    '#if defined(_NTDDK_)
    '    POOL_TYPE   PoolType;
    '#else // !_NTDDK_
    PoolType As POOL_TYPE
    '#endif // !_NTDDK_
    Frames As Long ' total number of allowable outstanding frames
    FrameSize As Long ' total size of frame
    'union {
    '    ULONG       FileAlignment;
    '    LONG        FramePitch; // When KSALLOCATOR_FLAG_2D_BUFFER_REQUIRED is set this field specifies the required 2d pitch for the buffer i.e. the width + stride
    '};
    FileAlignment As FileAlignmentConstants
    Reserved As Long
    
    'EUS
    Property Get RequirementsFlags() As KsAllocReqFlags: Return CType(Of KsAllocReqFlags)(Me.OptionsFlags): End Property
    Property Let RequirementsFlags(ByVal value As KsAllocReqFlags): Me.OptionsFlags = CType(Of KsAllocFlags)(value): End Property
End Type

