    Public Const KS_CC_SUBSTREAM_SERVICE_CC4  = &H0200
    Public Const KS_CC_SUBSTREAM_SERVICE_T3  = &H0400
    Public Const KS_CC_SUBSTREAM_SERVICE_T4  = &H0800
