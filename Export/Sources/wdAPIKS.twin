    Public Enum KsBitmapCompression
        KS_BI_RGB = 0
        KS_BI_RLE8 = 1
        KS_BI_RLE4 = 2
        KS_BI_BITFIELDS = 3
        KS_BI_JPEG = 4
    End Enum
    
    Public Type KS_RGBQUAD ' rgbq
        rgbBlue As Byte
        rgbGreen As Byte
        rgbRed As Byte
        rgbReserved As Byte
    End Type
    
    Public Enum KsPaletteConsts
        KS_iPALETTE_COLORS = 256    ' Maximum colours in palette
        KS_iEGA_COLORS = 16         ' Number colours in EGA palette
        KS_iMASK_COLORS = 3         ' Maximum three components
        KS_iTRUECOLOR = 16          ' Minimum true colour device
        KS_iRED = 0                 ' Index position for RED mask
        KS_iGREEN = 1               ' Index position for GREEN mask
        KS_iBLUE = 2                ' Index position for BLUE mask
        KS_iPALETTE = 8             ' Maximum colour depth using a palette
        KS_iMAXBITS = 8             ' Maximum bits per colour component
        KS_SIZE_EGA_PALETTE = (KS_iEGA_COLORS * 4 /* sizeof(KS_RGBQUAD) */)
        KS_SIZE_PALETTE = (KS_iPALETTE_COLORS * 4 /* sizeof(KS_RGBQUAD) */)
    End Enum
    
    Public Type KS_BITMAPINFOHEADER
        biSize As Long
        biWidth As Long
        biHeight As Long
        biPlanes As Integer
        biBitCount As Integer
        biCompression As KsBitmapCompression
        biSizeImage As Long
        biXPelsPerMeter As Long
        biYPelsPerMeter As Long
        biClrUsed As Long
        biClrImportant As Long
    End Type
    
    Public Type KS_TRUECOLORINFO
        dwBitMasks(0 To (KS_iMASK_COLORS - 1)) As Long
        bmiColors(0 To (KS_iPALETTE_COLORS - 1)) As KS_RGBQUAD
    End Type

    Public Function KS_WIDTHBYTES(ByVal bits As Long) As Long
        Return ((((bits) + 31) And (Not 31)) \ 8)
    End Function
    Public Function KS_DIBWIDTHBYTES(bi As BITMAPINFOHEADER) As Long
        Return KS_WIDTHBYTES(bi.biWidth * bi.biBitCount)
    End Function
    Public Function KS__DIBSIZE(bi As BITMAPINFOHEADER) As Long
        Return (KS_DIBWIDTHBYTES(bi) * bi.biHeight)
    End Function
    Public Function KS_DIBSIZE(bi As BITMAPINFOHEADER) As Long
        Return If(bi.biHeight < 0, (-1) * (KS__DIBSIZE(bi)), KS__DIBSIZE(bi))
    End Function

    Public Type KS_VIDEOINFOHEADER
        rcSource As RECT                    ' The bit we really want to use
        rcTarget As RECT                    ' Where the video should go
        dwBitRate As Long                   ' Approximate bit data rate
        dwBitErrorRate As Long              ' Bit error rate for this stream
        AvgTimePerFrame As REFERENCE_TIME   ' Average time per frame (100ns units)
        bmiHeader As KS_BITMAPINFOHEADER
    End Type
    
    Public Type KS_VIDEOINFO
        rcSource As RECT ' The bit we really want to use
        rcTarget As RECT ' Where the video should go
        dwBitRate As Long ' Approximate bit data rate
        dwBitErrorRate As Long ' Bit error rate for this stream
        AvgTimePerFrame As REFERENCE_TIME ' Average time per frame (100ns units)
        bmiHeader As KS_BITMAPINFOHEADER
        'union {
        '    KS_RGBQUAD          bmiColors[KS_iPALETTE_COLORS];     // Colour palette
        '    DWORD               dwBitMasks[KS_iMASK_COLORS];       // True colour masks
        '    KS_TRUECOLORINFO    TrueColorInfo;                     // Both of the above
        '};
        u(1023) As Byte
    End Type
    
    Public Const KS_SIZE_MASKS  = (KS_iMASK_COLORS * 4)
    Public Const KS_SIZE_PREHEADER = &H30 '(FIELD_OFFSET(KS_VIDEOINFOHEADER,bmiHeader))
    
    Public Function KS_SIZE_VIDEOHEADER(pbmi As KS_VIDEOINFO) As Long
        Return pbmi.bmiHeader.biSize + KS_SIZE_PREHEADER
    End Function
    
    Public Type KS_VBIINFOHEADER
        StartLine As Long              ' inclusive
        EndLine As Long                ' inclusive
        SamplingFrequency As Long      ' Hz.
        MinLineStartTime As Long       ' microSec * 100 from HSync LE
        MaxLineStartTime As Long       ' microSec * 100 from HSync LE
        ActualLineStartTime As Long    ' microSec * 100 from HSync LE
        ActualLineEndTime As Long      ' microSec * 100 from HSync LE
        VideoStandard As KS_AnalogVideoStandard ' KS_AnalogVideoStandard*
        SamplesPerLine As Long
        StrideInBytes As Long          ' May be > SamplesPerLine
        BufferSize As Long             ' Bytes
    End Type

    Public Const KS_VBIDATARATE_NABTS  = (5727272)
    Public Const KS_VBIDATARATE_CC  = (503493)  ' ~= 1/1.986125e-6
    Public Const KS_VBISAMPLINGRATE_4X_NABTS  = (4 * KS_VBIDATARATE_NABTS)
    Public Const KS_VBISAMPLINGRATE_47X_NABTS  = (27000000)
    Public Const KS_VBISAMPLINGRATE_5X_NABTS  = (5 * KS_VBIDATARATE_NABTS)
    Public Const KS_47NABTS_SCALER  = (KS_VBISAMPLINGRATE_47X_NABTS \ KS_VBIDATARATE_NABTS)
    
    Public Type KS_ANALOGVIDEOINFO
        rcSource As RECT                   ' Width max is 720, height varies w/ TransmissionStd
        rcTarget As RECT                   ' Where the video should go
        dwActiveWidth As Long              ' Always 720 (CCIR-601 active samples per line)
        dwActiveHeight As Long             ' 483 for NTSC, 575 for PAL/SECAM
        AvgTimePerFrame As REFERENCE_TIME  ' Normal ActiveMovie units (100 nS)
    End Type

    Public Enum KsTVTunerChangeFlags
        KS_TVTUNER_CHANGE_BEGIN_TUNE = &H0001   ' Starting a tuning operation
        KS_TVTUNER_CHANGE_END_TUNE = &H0002     ' Ending a tuning operation
    End Enum

    Public Type KS_TVTUNER_CHANGE_INFO
        dwFlags As KsTVTunerChangeFlags ' KS_TVTUNER_CHANGE_*
        dwCountryCode As Long
        dwAnalogVideoStandard As KS_AnalogVideoStandard ' KS_AnalogVideoStandard
        dwChannel As Long
    End Type

    Public Enum KS_MPEG2Level
        KS_MPEG2Level_Low
        KS_MPEG2Level_Main
        KS_MPEG2Level_High1440
        KS_MPEG2Level_High
    End Enum

    Public Enum KS_MPEG2Profile
        KS_MPEG2Profile_Simple
        KS_MPEG2Profile_Main
        KS_MPEG2Profile_SNRScalable
        KS_MPEG2Profile_SpatiallyScalable
        KS_MPEG2Profile_High
    End Enum

    Public Enum KsVidHeaderInterlaceFlags
        KS_INTERLACE_IsInterlaced = &H00000001  ' if 0, other interlace bits are irrelevent
        KS_INTERLACE_1FieldPerSample = &H00000002  ' else 2 fields per media sample
        KS_INTERLACE_Field1First = &H00000004  ' else Field 2 is first;  top field in PAL is field 1, top field in NTSC is field 2?
        KS_INTERLACE_UNUSED = &H00000008  '
        KS_INTERLACE_FieldPatternMask = &H00000030  ' use this mask with AMINTERLACE_FieldPat*
        KS_INTERLACE_FieldPatField1Only = &H00000000  ' Data never contains a Field2
        KS_INTERLACE_FieldPatField2Only = &H00000010  ' Data never contains a Field1
        KS_INTERLACE_FieldPatBothRegular = &H00000020  ' There will be a Field2 for every Field1 (required for Weave?)
        KS_INTERLACE_FieldPatBothIrregular = &H00000030  ' Random pattern of Field1s and Field2s
        KS_INTERLACE_DisplayModeMask = &H000000c0
        KS_INTERLACE_DisplayModeBobOnly = &H00000000
        KS_INTERLACE_DisplayModeWeaveOnly = &H00000040
        KS_INTERLACE_DisplayModeBobOrWeave = &H00000080
    End Enum

    Public Enum KSVidHeaderCopyProtectFlags
        KSCOPYPROTECT_RestrictDuplication = 1
        KS_COPYPROTECT_RestrictDuplication = 1
    End Enum

    Public Enum KsMPEG2Flags
        KS_MPEG2_DoPanScan = &H00000001           'if set, the MPEG-2 video decoder should crop output image
                                                '   based on pan-scan vectors in picture_display_extension
                                                '   and change the picture aspect ratio accordingly.
        KS_MPEG2_DVDLine21Field1 = &H00000002     'if set, the MPEG-2 decoder must be able to produce an output
                                                '   pin for DVD style closed caption data found in GOP layer of field 1
        KS_MPEG2_DVDLine21Field2 = &H00000004     'if set, the MPEG-2 decoder must be able to produce an output
                                                '   pin for DVD style closed caption data found in GOP layer of field 2
        KS_MPEG2_SourceIsLetterboxed = &H00000008 'if set, indicates that black bars have been encoded in the top
                                                '   and bottom of the video.
        KS_MPEG2_FilmCameraMode = &H00000010      'if set, indicates "film mode" used for 625/50 content.  If cleared,
                                                '   indicates that "camera mode" was used.
        KS_MPEG2_LetterboxAnalogOut = &H00000020  'if set and this stream is sent to an analog output, it should
                                                '   be letterboxed.  Streams sent to VGA should be letterboxed only by renderers.
        KS_MPEG2_DSS_UserData = &H00000040        'if set, the MPEG-2 decoder must process DSS style user data
        KS_MPEG2_DVB_UserData = &H00000080        'if set, the MPEG-2 decoder must process DVB style user data
        KS_MPEG2_27MhzTimebase = &H00000100       'if set, the PTS,DTS timestamps advance at 27MHz rather than 90KHz
                                                ' #if (NTDDI_VERSION >= NTDDI_WINXP)
        KS_MPEG2_WidescreenAnalogOut = &H00000200 'if set and this stream is sent to an analog output, it should
                                                '   be in widescreen format (4x3 content should be centered on a 16x9 output).
                                                '   Streams sent to VGA should be widescreened only by renderers.
    End Enum
    
    Public Enum KSVHControlFlags
        KS_AMCONTROL_USED = &H00000001               ' Used to test if these flags are supported.  Set and test for AcceptMediaType.
                                                     '  If rejected, then you cannot use the AMCONTROL flags (send 0 for dwReserved1)
        KS_AMCONTROL_PAD_TO_4x3 = &H00000002         ' if set means display the image in a 4x3 area
        KS_AMCONTROL_PAD_TO_16x9 = &H00000004        ' if set means display the image in a 16x9 area
        KS_AMCONTROL_COLORINFO_PRESENT = &H00000080  ' if set, indicates DXVA color info is present in the upper (24) bits of the dwControlFlags
    End Enum
    
    Public Type KS_VIDEOINFOHEADER2
        rcSource As RECT
        rcTarget As RECT
        dwBitRate As Long
        dwBitErrorRate As Long
        AvgTimePerFrame As REFERENCE_TIME
        dwInterlaceFlags As KsVidHeaderInterlaceFlags ' use AMINTERLACE_* defines. Reject connection if undefined bits are not 0
        dwCopyProtectFlags As KSVidHeaderCopyProtectFlags ' use KS_COPYPROTECT_* defines. Reject connection if undefined bits are not 0
        dwPictAspectRatioX As Long ' X dimension of picture aspect ratio, e.g. 16 for 16x9 display
        dwPictAspectRatioY As Long ' Y dimension of picture aspect ratio, e.g.  9 for 16x9 display
        '    union {
        dwControlFlags As KSVHControlFlags ' use KS_AMCONTROL_* defines, use this from now on
        '        DWORD dwReserved1;                  // for backward compatiblity (was "must be 0";  connection rejected otherwise)
        '    };
        dwReserved2 As Long ' must be 0; reject connection otherwise
        bmiHeader As KS_BITMAPINFOHEADER
    End Type
    
    Public Type KS_MPEG1VIDEOINFO
        hdr As KS_VIDEOINFOHEADER ' Compatible with VIDEOINFO
        dwStartTimeCode As Long ' 25-bit Group of pictures time code at start of data
        cbSequenceHeader As Long ' Length in bytes of bSequenceHeader
        bSequenceHeader(0 To 0) As Byte ' Sequence header including quantization matrices if any
    End Type
    
    Public Const KS_MAX_SIZE_MPEG1_SEQUENCE_INFO = 140
    
    Public Function KS_SIZE_MPEG1VIDEOINFO(pv As KS_MPEG1VIDEOINFO) As Long
        Return &H60 + pv.cbSequenceHeader ' (FIELD_OFFSET(KS_MPEG1VIDEOINFO, bSequenceHeader[0]) + (pv)->cbSequenceHeader)
    End Function
    
    ' #define KS_MPEG1_SEQUENCE_INFO(pv) ((const BYTE *)(pv)->bSequenceHeader)
    
    Public Type KS_MPEGVIDEOINFO2
        hdr As KS_VIDEOINFOHEADER2
        dwStartTimeCode As Long            '  ?? not used for DVD ??
        cbSequenceHeader As Long           ' is 0 for DVD (no sequence header)
        dwProfile As KS_MPEG2Profile       ' use enum MPEG2Profile
        dwLevel As KS_MPEG2Level           ' use enum MPEG2Level
        dwFlags As Mpeg2VidInfoFlags       ' use AMMPEG2_* defines.  Reject connection if undefined bits are not 0
        bSequenceHeader(0 To 0) As Long    ' DWORD instead of Byte for alignment purposes
                                           '   For MPEG-2, if a sequence_header is included, the sequence_extension
                                           '   should also be included
    End Type
    
    Public Type KS_H264VIDEOINFO
        ' from UVC 1.5 H.264 frame descriptor
        wWidth As Integer
        wHeight As Integer
        wSARwidth As Integer
        wSARheight As Integer
        wProfile As Integer
        bLevelIDC As Byte
        wConstrainedToolset As Integer
        bmSupportedUsages As Long
        bmCapabilities As Integer
        bmSVCCapabilities As Long
        bmMVCCapabilities As Long
        dwFrameInterval As Long
        ' from UVC 1.5 H.264 format descriptor
        bMaxCodecConfigDelay As Byte
        bmSupportedSliceModes As Byte
        bmSupportedSyncFrameTypes As Byte
        bResolutionScaling As Byte
        bSimulcastSupport As Byte
        bmSupportedRateControlModes As Byte
        wMaxMBperSecOneResolutionNoScalability As Integer
        wMaxMBperSecTwoResolutionsNoScalability As Integer
        wMaxMBperSecThreeResolutionsNoScalability As Integer
        wMaxMBperSecFourResolutionsNoScalability As Integer
        wMaxMBperSecOneResolutionTemporalScalability As Integer
        wMaxMBperSecTwoResolutionsTemporalScalablility As Integer
        wMaxMBperSecThreeResolutionsTemporalScalability As Integer
        wMaxMBperSecFourResolutionsTemporalScalability As Integer
        wMaxMBperSecOneResolutionTemporalQualityScalability As Integer
        wMaxMBperSecTwoResolutionsTemporalQualityScalability As Integer
        wMaxMBperSecThreeResolutionsTemporalQualityScalablity As Integer
        wMaxMBperSecFourResolutionsTemporalQualityScalability As Integer
        wMaxMBperSecOneResolutionTemporalSpatialScalability As Integer
        wMaxMBperSecTwoResolutionsTemporalSpatialScalability As Integer
        wMaxMBperSecThreeResolutionsTemporalSpatialScalablity As Integer
        wMaxMBperSecFourResolutionsTemporalSpatialScalability As Integer
        wMaxMBperSecOneResolutionFullScalability As Integer
        wMaxMBperSecTwoResolutionsFullScalability As Integer
        wMaxMBperSecThreeResolutionsFullScalability As Integer
        wMaxMBperSecFourResolutionsFullScalability As Integer
    End Type
    
    Public Function KS_SIZE_MPEG1VIDEOINFO2(pv As KS_MPEGVIDEOINFO2) As Long
        Return &H84 + pv.cbSequenceHeader ' (FIELD_OFFSET(KS_MPEGVIDEOINFO2, bSequenceHeader[0]) + (pv)->cbSequenceHeader)
    End Function
    
    ' #define KS_MPEG1_SEQUENCE_INFO(pv) ((const BYTE *)(pv)->bSequenceHeader)
    
