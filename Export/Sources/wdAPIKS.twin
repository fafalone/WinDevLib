    End Type
    
    Public Enum KsVideoFlags
        KS_VIDEO_FLAG_FIELD_MASK = &H0003  ' Frame or Field (default is frame)
        KS_VIDEO_FLAG_FRAME = &H0000  ' Frame or Field (default is frame)
        KS_VIDEO_FLAG_FIELD1 = &H0001
        KS_VIDEO_FLAG_FIELD2 = &H0002
        KS_VIDEO_FLAG_FIELD1FIRST = &H0004
        KS_VIDEO_FLAG_WEAVE = &H0008
        KS_VIDEO_FLAG_IPB_MASK = &H0030  ' I, B, or P (default is I)
        KS_VIDEO_FLAG_I_FRAME = &H0000  ' I, B, or P (default is I)
        KS_VIDEO_FLAG_P_FRAME = &H0010
        KS_VIDEO_FLAG_B_FRAME = &H0020
        KS_VIDEO_FLAG_REPEAT_FIELD = &H0040
    End Enum
    
    Public Type KS_FRAME_INFO
        ExtendedHeaderSize As Long   ' Size of this extended header
        dwFrameFlags As KsVideoFlags ' Field1, Field2, or Frame
        PictureNumber As LongLong
        DropCount As LongLong
        ' The following are only set when using OverlayMixer
        hDirectDraw As LongPtr      ' user mode DDraw handle
        hSurfaceHandle As LongPtr   ' user mode surface handle
        DirectDrawRect As RECT      ' portion of surface locked
        '  union {
        '      LONG                    lSurfacePitch;
        '// Contains surface pitch a.k.a stride
        '      DWORD                   Reserved1;
        '  };
        lSurfacePitch As Long
        Reserved2 As Long
        'union {
        '    struct {
        '        DWORD       Reserved3;
        '        DWORD       Reserved4;
        '    };
        '    ULONGLONG   FrameCompletionNumber;
        '};
        FrameCompletionNumber As LongLong
    End Type
    
    Public Enum KsVbiFlags
        KS_VBI_FLAG_FRAME = &H0000  ' Frame or Field (default is frame)
        KS_VBI_FLAG_FIELD1 = &H0001
        KS_VBI_FLAG_FIELD2 = &H0002
    ' #if (NTDDI_VERSION >= NTDDI_WINXP)
        KS_VBI_FLAG_MV_PRESENT = &H0100
        KS_VBI_FLAG_MV_HARDWARE = &H0200
        KS_VBI_FLAG_MV_DETECTED = &H0400
    ' #endif // (NTDDI_VERSION >= NTDDI_WINXP)
        KS_VBI_FLAG_TVTUNER_CHANGE = &H0010  ' TvTunerChangeInfo is valid
        KS_VBI_FLAG_VBIINFOHEADER_CHANGE = &H0020  ' VBIInfoHeader is valid
    End Enum
    
    Public Type KS_VBI_FRAME_INFO
        ExtendedHeaderSize As Long ' Size of this extended header
        dwFrameFlags As KsVbiFlags ' Field1, Field2, or Frame; & etc
        PictureNumber As LongLong  ' Test only?
        DropCount As LongLong      ' Test only?
        dwSamplingFrequency As Long
        TvTunerChangeInfo As KS_TVTUNER_CHANGE_INFO
        VBIInfoHeader As KS_VBIINFOHEADER
        'The following are for VRAM surface transport to support LDDM Capture
        'VRAM_SURFACE_INFO             VramSurfaceInfo;
    End Type
    
