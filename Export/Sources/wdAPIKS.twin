    Public Function IS_VALID_WAVEFORMATEX_GUID(ByRef Guid As UUID) As Boolean
        Dim ksFmt As UUID = KSDATAFORMAT_SUBTYPE_WAVEFORMATEX
        Dim cb As LongPtr = LenB(Of UUID) - 2
        Return RtlCompareMemory(ByVal VarPtr(ksFmt) + 2, ByVal VarPtr(Guid) + 2, cb) = cb
    End Function
    
    Public Function IS_COMPATIBLE_MMREG_MID(ByRef guid As UUID) As Boolean
        With guid
            If .Data1 < &HD5A47FA7 OrElse .Data1 >= &HD5A57FA6 Then Return False
            If .Data2 <> &H6D98 OrElse .Data3 <> &H11D1 Then Return False
            Return .Data4(0) = &HA2 AndAlso .Data4(1) = &H1A AndAlso .Data4(2) = &H0 AndAlso .Data4(3) = &HA0 AndAlso .Data4(4) = &HC9 AndAlso .Data4(5) = &H22 AndAlso .Data4(6) = &H31 AndAlso .Data4(7) = &H96
        End With
    End Function
    
    Public Function IS_COMPATIBLE_MMREG_PID(ByRef guid As UUID) As Boolean
        With guid
            If .Data1 < &HE36DC2AC OrElse .Data1 >= &HE36EC2AB Then Return False
            If .Data2 <> &H6D9A OrElse .Data3 <> &H11D1 Then Return False
            Return .Data4(0) = &HA2 AndAlso .Data4(1) = &H1A AndAlso .Data4(2) = &H0 AndAlso .Data4(3) = &HA0 AndAlso .Data4(4) = &HC9 AndAlso .Data4(5) = &H22 AndAlso .Data4(6) = &H31 AndAlso .Data4(7) = &H96
        End With
    End Function
    
