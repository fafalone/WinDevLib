' DEFINE_KSPROPERTY_ITEM(\
    ' KSPROPERTY_GENERAL_COMPONENTID,\
    ' (Handler),\
    ' sizeof(KSPROPERTY),\
    ' sizeof(KSCOMPONENTID),\
    ' NULL, NULL, 0, NULL, NULL, 0)
    
    
    

Public Function DEFINE_KSPROPERTY_ITEM(ByVal PropertyId As Long, ByVal GetHandler As LongPtr, _
                                        ByVal MinProperty As Long, _
                                        ByVal MinData As Long, _
                                        ByVal SetHandler As LongPtr, _
                                        ByVal Values As LongPtr, ByVal RelationsCount As Long, ByVal Relations As LongPtr, ByVal SupportHandler As LongPtr, _
                                        ByVal SerializedSize As Long) As KSPROPERTY_ITEM
    With DEFINE_KSPROPERTY_ITEM
        .PropertyId = PropertyId
        .GetPropertyHandler = GetHandler
        .MinProperty = MinProperty
        .MinData = MinData
        .SetPropertyHandler = SetHandler
        .RelationsCount = RelationsCount
        .Relations = Relations
        .SupportHandler = SupportHandler
        .SerializedSize = SerializedSize
    End With
End Function

