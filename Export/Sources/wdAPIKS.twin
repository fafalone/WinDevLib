    Public Type KS_VIDEO_STREAM_CONFIG_CAPS
        guid As UUID                   ' will be MEDIATYPE_Video
        VideoStandard As KS_AnalogVideoStandard ' logical OR of all AnalogVideoStandards
                                       ' supported
        InputSize As SIZE              ' the inherent size of the incoming signal
                                       ' (every pixel unique)
        MinCroppingSize As SIZE        ' smallest rcSrc cropping rect allowed
        MaxCroppingSize As SIZE        ' largest rcSrc cropping rect allowed
        CropGranularityX As Long       ' granularity of cropping size
        CropGranularityY As Long
        CropAlignX As Long             ' alignment of cropping rect
        CropAlignY As Long
        MinOutputSize As SIZE          ' smallest bitmap stream can produce
        MaxOutputSize As SIZE          ' largest  bitmap stream can produce
        OutputGranularityX As Long     ' granularity of output bitmap size
        OutputGranularityY As Long
        StretchTapsX As Long           ' 0, no stretch, 1 pix dup, 2 interp, ...
        StretchTapsY As Long           '    Describes quality of hardware scaler
        ShrinkTapsX As Long            '
        ShrinkTapsY As Long            '
        MinFrameInterval As LongLong   ' 100 nS units
        MaxFrameInterval As LongLong
        MinBitsPerSecond As Long
        MaxBitsPerSecond As Long
    End Type

