    Public Type KSCAMERA_EXTENDEDPROP_DIGITALWINDOW_CONFIGCAPS
        ResolutionX As Long            ' Output width in pixels
        ResolutionY As Long            ' Output height in pixels
        PorchTop As Long               ' Upper porch region in Q24
        PorchLeft As Long              ' Left-most porch region in Q24
        PorchBottom As Long            ' Lower porch region in Q24
        PorchRight As Long             ' Right-most porch region in Q24
        NonUpscalingWindowSize As Long ' Q24 value to get no scaling
