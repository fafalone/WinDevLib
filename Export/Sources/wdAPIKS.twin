    End Type
    
    Public Type KSCAMERA_EXTENDEDPROP_FIELDOFVIEW2_CONFIGCAPS
        DefaultDiagonalFieldOfViewInDegrees As Integer ' This is the default Field of View value in degrees.
        DiscreteFoVStopsCount As Integer ' Count of used entries in DiscreteFoVStops array.
        DiscreteFoVStops(0 To 359) As Integer ' Descending list of FoV Stops in degrees.
        Reserved As Long ' For 8-byte size align
    End Type
    
    Public Type KSCAMERA_EXTENDEDPROP_BACKGROUNDSEGMENTATION_CONFIGCAPS
        ' Output width and height in pixels
        Resolution As SIZE
        ' The maximum frame rate the driver can accommodate  for achieving
        ' background segmentation for each frame corresponding to Resolution
        'struct
        '{
        '    LONG Numerator;
        '    LONG Denominator;
        '} MaxFrameRate;
        MaxFrameRate_Numerator As Long
        MaxFrameRate_Denominator As Long
        ' The width and height of the mask produced when streaming
        ' with a MediaType corresponding to Resolution and MaxFrameRate
        MaskResolution As SIZE
        ' Optional subtype for which this configuration capability applies. If left
        ' to zero, all streams conforming the Resolution and MaxFrameRate will support
        ' background segmentation with the specified MaskResolution.
        SubType As UUID
    End Type
    
