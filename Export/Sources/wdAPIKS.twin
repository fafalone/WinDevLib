    Static iid As UUID
     If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H6a2e0605, &H28e4, &H11d0, &Ha1, &H8c, &H00, &Ha0, &Hc9, &H11, &H89, &H56)
    PROPSETID_TUNER = iid
    End Function
    
    Public Enum KSPROPERTY_TUNER
        KSPROPERTY_TUNER_CAPS                  ' R  -overall device capabilities
        KSPROPERTY_TUNER_MODE_CAPS             ' R  -capabilities in this mode
        KSPROPERTY_TUNER_MODE                  ' RW -set a mode (TV, FM, AM, DSS)
        KSPROPERTY_TUNER_STANDARD              ' R  -get TV standard (only if TV mode)
        KSPROPERTY_TUNER_FREQUENCY             ' RW -set/get frequency
        KSPROPERTY_TUNER_INPUT                 ' RW -select an input
        KSPROPERTY_TUNER_STATUS                ' R  -tuning status
        KSPROPERTY_TUNER_IF_MEDIUM             ' R O-Medium for IF or Transport Pin
        KSPROPERTY_TUNER_SCAN_CAPS             ' R  -overall device capabilities for scanning
        KSPROPERTY_TUNER_SCAN_STATUS           ' R  -status of scan
        KSPROPERTY_TUNER_STANDARD_MODE         ' RW -autodetect mode for signal standard
        KSPROPERTY_TUNER_NETWORKTYPE_SCAN_CAPS ' R -network type specific tuner capabilities
    End Enum
    
    Public Enum KSPROPERTY_TUNER_MODES
        KSPROPERTY_TUNER_MODE_TV = &H0001
        KSPROPERTY_TUNER_MODE_FM_RADIO = &H0002
        KSPROPERTY_TUNER_MODE_AM_RADIO = &H0004
        KSPROPERTY_TUNER_MODE_DSS = &H0008
        KSPROPERTY_TUNER_MODE_ATSC = &H0010 ' also used for DVB-T, DVB-C
    End Enum
    
    Public Enum KS_TUNER_TUNING_FLAGS
        KS_TUNER_TUNING_EXACT = 1 ' No fine tuning
        KS_TUNER_TUNING_FINE      ' Fine grained search
        KS_TUNER_TUNING_COARSE    ' Coarse search
    End Enum
    
    Public Enum KS_TUNER_STRATEGY
        KS_TUNER_STRATEGY_PLL = &H01             ' Tune by PLL offset
        KS_TUNER_STRATEGY_SIGNAL_STRENGTH = &H02 ' Tune by signal strength
        KS_TUNER_STRATEGY_DRIVER_TUNES = &H04    ' Driver does fine tuning
    End Enum
    
    Public Type KSPROPERTY_TUNER_CAPS_S
        Property As KSPROPERTY
        ModesSupported As KSPROPERTY_TUNER_MODES ' KS_PROPERTY_TUNER_MODES_*
        VideoMedium As KSPIN_MEDIUM              ' GUID_NULL (no pin), or GUID
        TVAudioMedium As KSPIN_MEDIUM            ' GUID_NULL (no pin), or GUID
        RadioAudioMedium As KSPIN_MEDIUM         ' GUID_NULL (no pin), or GUID
    End Type
    
    Public Type KSPROPERTY_TUNER_IF_MEDIUM_S
        Property As KSPROPERTY
        IFMedium As KSPIN_MEDIUM ' GUID_NULL (no pin), or GUID
    End Type
    
    Public Type KSPROPERTY_TUNER_MODE_CAPS_S
        Property As KSPROPERTY
        Mode As KSPROPERTY_TUNER_MODES ' IN: KSPROPERTY_TUNER_MODE
        StandardsSupported As KS_AnalogVideoStandard ' KS_AnalogVideo_* (if TV or DSS)
        MinFrequency As Long       ' Hz
        MaxFrequency As Long       ' Hz
        TuningGranularity As Long  ' Hz
        NumberOfInputs As Long     ' count of inputs
        SettlingTime As Long       ' milliSeconds
        Strategy As KS_TUNER_STRATEGY ' KS_TUNER_STRATEGY
    End Type
    
    Public Type KSPROPERTY_TUNER_MODE_S
        Property As KSPROPERTY
        Mode As KSPROPERTY_TUNER_MODES ' IN: KSPROPERTY_TUNER_MODE
    End Type
    
    Public Type KSPROPERTY_TUNER_FREQUENCY_S
        Property As KSPROPERTY
        Frequency As Long          ' Hz
        LastFrequency As Long      ' Hz (last known good)
        TuningFlags As KS_TUNER_TUNING_FLAGS ' KS_TUNER_TUNING_FLAGS
        VideoSubChannel As Long    ' DSS
        AudioSubChannel As Long    ' DSS
        Channel As Long            ' VBI decoders
        Country As Long            ' VBI decoders
    End Type
    
    Public Type KSPROPERTY_TUNER_STANDARD_S
        Property As KSPROPERTY
        Standard As KS_AnalogVideoStandard ' KS_AnalogVideo_*
    End Type
    
    Public Type KSPROPERTY_TUNER_STANDARD_MODE_S
        Property As KSPROPERTY
        AutoDetect As BOOL ' RW - specifies whether the driver is in auto-detect mode for the signal standard
    End Type
    
    Public Type KSPROPERTY_TUNER_INPUT_S
        Property As KSPROPERTY
        InputIndex As Long ' 0 to (n-1) inputs
    End Type
    
    Public Type KSPROPERTY_TUNER_STATUS_S
        Property As KSPROPERTY
        CurrentFrequency As Long   ' Hz
        PLLOffset As Long          ' if Strategy.KS_TUNER_STRATEGY_PLL
        SignalStrength As Long     ' if Stretegy.KS_TUNER_STRATEGY_SIGNAL_STRENGTH
        Busy As Long               ' TRUE if in the process of tuning
    End Type
    
    Public Enum TunerLockType
        Tuner_LockType_None = &H00 ' Not locked on a signal. Can be returned at end of scan.
        Tuner_LockType_Within_Scan_Sensing_Range = &H01 ' Signal is near by, not able to report exact frequency. Can be returned at end of scan.
        Tuner_LockType_Locked = &H02 ' Fine tune signal lock established. Can be returned at end of scan.
    End Enum
    
    Public Type TUNER_ANALOG_CAPS_S
        Mode As KSPROPERTY_TUNER_MODES                   ' IN -KSPROPERTY_TUNER_MODE
        StandardsSupported As KS_AnalogVideoStandard     ' KS_AnalogVideo_* (defined in KS_AnalogVideoStandard)
        MinFrequency As Long           ' R -Hz
        MaxFrequency As Long           ' R -Hz
        TuningGranularity As Long      ' R -Hz
        SettlingTime As Long           ' R -milliSeconds
        ScanSensingRange As Long       ' R -max range (Hz) in which tuner can detect presence of a signal
        FineTuneSensingRange As Long   ' R -max range (Hz) in which tuner can detect actual frequency of a signal
    End Type
    
