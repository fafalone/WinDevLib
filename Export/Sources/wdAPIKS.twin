        wVerticalAngleEnd As Integer                           ' Work Volume Vertical Angle End
        wHorizontalAngleBegin As Integer                       ' Work Volume HorizontalAngle Begin
        wHorizontalAngleEnd As Integer                         ' Work Volume HorizontalAngle End
        usFrequencyBandLo As Integer                           ' Low end of Freq Range
        usFrequencyBandHi As Integer                           ' High end of Freq Range
        usNumberOfMicrophones As Integer                       ' Count of microphone
                                                            ' coordinate structures
                                                            ' to follow.
        KsMicCoord(0 To 0) As KSAUDIO_MICROPHONE_COORDINATES   ' Array of Microphone
                                                            ' Coordinate structures
    End Type
    
    Public Type DS3DVECTOR
        'union {
        '    FLOAT x;
        '    FLOAT dvX;
        '};
        'union {
        '    FLOAT y;
        '    FLOAT dvY;
        '};
        'union {
        '    FLOAT z;
        '    FLOAT dvZ;
        '};
        x As Single
        y As Single
        z As Single
        
        'EUS
        Property Get dvX() As Single: Return Me.x: End Property
        Property Let dvX(ByVal value As Single): Me.x = value: End Property
        Property Get dvY() As Single: Return Me.y: End Property
        Property Let dvY(ByVal value As Single): Me.y = value: End Property
        Property Get dvZ() As Single: Return Me.z: End Property
        Property Let dvZ(ByVal value As Single): Me.z = value: End Property
    End Type
    
