    End Type
    
    Public Type VBICODECFILTERING_STATISTICS_COMMON
        InputSRBsProcessed As Long     ' upstream SRBs received
        OutputSRBsProcessed As Long    ' downstream SRBs sent
        SRBsIgnored As Long            ' SRBs ignored due to no requests
        InputSRBsMissing As Long       ' SRBs dropped upstream
        OutputSRBsMissing As Long      ' Output dropped because no SRB pending
        OutputFailures As Long         ' dropped because of other failure
        InternalErrors As Long         ' could not process due to int. failure
        ExternalErrors As Long         ' could not process due to ext. failure
        InputDiscontinuities As Long   ' discontinuities received
        DSPFailures As Long            ' DSP confidence failure
        TvTunerChanges As Long         ' number of received KS_TVTUNER_CHANGE_BEGIN_TUNE and KS_TVTUNER_CHANGE_END_TUNE pairs.
        VBIHeaderChanges As Long       ' number of received KS_VBI_FLAG_VBIINFOHEADER_CHANGE
        LineConfidenceAvg As Long      ' Average of all DSP confidence results
        BytesOutput As Long            ' Bytes sent downstream 
    End Type
    
    Public Type VBICODECFILTERING_STATISTICS_COMMON_PIN
        SRBsProcessed As Long      ' SRBs sent/received
        SRBsIgnored As Long        ' SRBs ignored due to filtering
        SRBsMissing As Long        ' SRBs not sent/received
        InternalErrors As Long     ' could not send/receive due to int. failure
        ExternalErrors As Long     ' could not send/receive due to ext. failure
        Discontinuities As Long    ' discontinuities received/sent
        LineConfidenceAvg As Long  ' Average of all DSP confidence results for this pin
        BytesOutput As Long        ' Bytes sent downstream
    End Type
    
    Public Type VBICODECFILTERING_STATISTICS_NABTS
        Common As VBICODECFILTERING_STATISTICS_COMMON  ' Generic VBI statistics
        FECBundleBadLines As Long                      ' Un-FEC-correctable lines
        FECQueueOverflows As Long                      ' Number of times FEC queue overflowed
        FECCorrectedLines As Long                      ' Lines CSUM corrected by FEC
        FECUncorrectableLines As Long                  ' FEC input lines not CSUM correctable
        BundlesProcessed As Long                       ' Bundles received from FEC
        BundlesSent2IP As Long                         ' Bundles sent to IP driver
        FilteredLines As Long                          ' Lines processed and then dropped
                                                       ' because no one was interested
    End Type
    
    Public Type VBICODECFILTERING_STATISTICS_NABTS_PIN
        Common As VBICODECFILTERING_STATISTICS_COMMON_PIN ' Generic VBI pin statistics
    End Type
    
    Public Type VBICODECFILTERING_STATISTICS_CC
        Common As VBICODECFILTERING_STATISTICS_COMMON ' Generic VBI statistics
    End Type
    
    Public Type VBICODECFILTERING_STATISTICS_CC_PIN
        Common As VBICODECFILTERING_STATISTICS_COMMON_PIN ' Generic VBI pin statistics
    End Type
    
    Public Type VBICODECFILTERING_STATISTICS_TELETEXT
