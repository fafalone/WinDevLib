    Public Type KSCAMERA_EXTENDEDPROP_VALUE
        'union
        '{
        '    double          dbl;
        '    ULONGLONG       ull;
        '    ULONG           ul;
        '    ULARGE_INTEGER  ratio;
        '    LONG            l;
        '    LONGLONG        ll;
        '} Value;
        Value As LongLong
        
        'EUS
        Property Get dbl() As Double
          Return DCast(Of Double)(Me.Value)
        End Property
        Property Let dbl(ByVal value As Double)
            CopyMemory Me.Value, value, 8
        End Property
        Property Get ull() As LongLong
          Return Me.Value
        End Property
        Property Let ull(ByVal value As LongLong)
            Me.Value = value
        End Property
        Property Get ul() As Long
          Dim tmp As Long
          CopyMemory tmp, Me.Value, 4
          Return tmp
        End Property
        Property Let ul(ByVal value As Long)
            CopyMemory Me.Value, value, 4
        End Property
        Property Get ratio() As ULARGE_INTEGER
          ratio.QuadPart = Me.Value
        End Property
        Property Let ratio(ByVal value As ULARGE_INTEGER)
            Me.Value = value.QuadPart
        End Property
        Property Get l() As Long
          Dim tmp As Long
          CopyMemory tmp, Me.Value, 4
          Return tmp
        End Property
        Property Let l(ByVal value As Long)
            CopyMemory Me.Value, value, 4
        End Property
        Property Get ll() As LongLong
          Return Me.Value
        End Property
        Property Let ll(ByVal value As LongLong)
            Me.Value = value
        End Property
    End Type

