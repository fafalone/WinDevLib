Public Type KSPROPERTY_ITEM
    PropertyId As Long
    'union {
    '    PFNKSHANDLER            GetPropertyHandler;
    '    BOOLEAN                 GetSupported;
    '};
    GetPropertyHandler As LongPtr
    MinProperty As Long
    MinData As Long
    'union {
    '    PFNKSHANDLER            SetPropertyHandler;
    '    BOOLEAN                 SetSupported;
    '};
    SetPropertyHandler As LongPtr
    Values As LongPtr 'KSPROPERTY_VALUES*
    RelationsCount As Long
    Relations As LongPtr 'KSPROPERTY*
    SupportHandler As LongPtr 'PFNKSHANDLER
    SerializedSize As Long
    
    'EUS
    Property Get GetSupported() As Byte
    Dim tmp As Byte
    CopyMemory tmp, Me.GetPropertyHandler, 1
    Return tmp
    End Property
    Property Let GetSupported(ByVal value As Byte)
    CopyMemory Me.GetPropertyHandler, value, 1
    End Property
    Property Get SetSupported() As Byte
    Dim tmp As Byte
    CopyMemory tmp, Me.SetPropertyHandler, 1
    Return tmp
    End Property
    Property Let SetSupported(ByVal value As Byte)
    CopyMemory Me.SetPropertyHandler, value, 1
    End Property
End Type





