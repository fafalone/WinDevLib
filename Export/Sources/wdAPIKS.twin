    '  The following flags describe CC field 1 substreams: CC1,CC2,TT1,TT2
    Public Const KS_CC_SUBSTREAM_FIELD1_MASK  = &H00F0
    Public Const KS_CC_SUBSTREAM_SERVICE_CC1  = &H0010
    Public Const KS_CC_SUBSTREAM_SERVICE_CC2  = &H0020
    Public Const KS_CC_SUBSTREAM_SERVICE_T1  = &H0040
    Public Const KS_CC_SUBSTREAM_SERVICE_T2  = &H0080
    '  The following flags describe CC field 2 substreams: CC3,CC4,TT3,TT4,XDS
