Public Type KSIDENTIFIER
' typedef struct {
'   union {
'     struct {
'       GUID  Set;
'       ULONG Id;
'       ULONG Flags;
'     } _IDENTIFIER;
'     struct {
'       GUID  Set;
'       ULONG Id;
'       ULONG Flags;
'     };
'     LONGLONG Alignment;
'   };
' } KSIDENTIFIER, *PKSIDENTIFIER;
  Alignment As LongLong
  ___u(3) As Long
  
  'EUS
  Property Get Set() As UUID
    Dim tmp As UUID
    CopyMemory tmp, ByVal VarPtr(Me.Alignment), 16
    Return tmp
  End Property
  Property Let Set(pguid As UUID)
      CopyMemory ByVal VarPtr(Me.Alignment), pguid.Data1, 16
  End Property
  Property Get Id() As Long
    Return Me.___u(2)
  End Property
  Property Let Id(ByVal value As Long)
      Me.___u(2) = value
  End Property
  Property Get Flags() As Long
    Return Me.___u(3)
  End Property
  Property Let Flags(ByVal value As Long)
      Me.___u(3) = value
  End Property
End Type
'Alias KSPROPERTY As KSIDENTIFIER 




