Public Enum AGNSSFormats
    GNSS_AGNSSFORMAT_XTRA1 = &H01
    GNSS_AGNSSFORMAT_XTRA2 = &H02
    GNSS_AGNSSFORMAT_LTO = &H04
    GNSS_AGNSSFORMAT_XTRA3 = &H08
    GNSS_AGNSSFORMAT_XTRA3_1 = &H10
    GNSS_AGNSSFORMAT_XTRA3_2 = &H20
    GNSS_AGNSSFORMAT_XTRA_INT = &H40
End Enum

Public Function GUID_DEVINTERFACE_GNSS() As UUID
'{3336e5e4-018a-4669-84c5-bd05f3bd368b}
Static iid As UUID
    If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H3336e5e4, CInt(&H018a), CInt(&H4669), &H84, &Hc5, &Hbd, &H05, &Hf3, &Hbd, &H36, &H8b)
    GUID_DEVINTERFACE_GNSS = iid
End Function

Public Const MAX_SERVER_URL_NAME = 260

Public Const MIN_GEOFENCES_REQUIRED = 100

'  Enumerate all versions of Breadcrumbs
Public Const BREADCRUMBING_UNSUPPORTED  = 0
Public Const BREADCRUMBING_VERSION_1  = 1
'  Define the minimum number of breadcrumbs that must be stored in order for a driver
'  to be considered conforming to the breadcrumbing portions of the interface
Public Const MIN_BREADCRUMBS_SUPPORTED  = 120

Public Type GNSS_SUPL_VERSION
    MajorVersion As Long
    MinorVersion As Long
End Type

Public Type GNSS_SUPL_VERSION_2
    MajorVersion As Long
    MinorVersion As Long
    ServiceIndicator As Long
End Type

Public Type GNSS_DEVICE_CAPABILITY
    Size As Long
    ' The version number of this structure is the DDK version against which the GNSS Driver is developed
    Version As Long
    ' Session Management
    SupportMultipleFixSessions As BOOL
    SupportMultipleAppSessions As BOOL
    ' AGNSS
    RequireAGnssInjection As BOOL
    AgnssFormatSupported As Long
    AgnssFormatPreferred As Long
    ' Tracking support
    SupportDistanceTracking As BOOL
    SupportContinuousTracking As BOOL
    ' Reserved fields for future use
    Reserved1 As Long
    Reserved2 As BOOL
    Reserved3 As BOOL
    Reserved4 As BOOL
    Reserved5 As BOOL
    ' Geofencing
    GeofencingSupport As Long
    ' Reserved fields for future use
    Reserved6 As BOOL
    Reserved7 As BOOL
    ' SUPL/CP
    SupportCpLocation As BOOL
    SupportUplV2 As BOOL
    SupportSuplV1 As BOOL
    SupportSuplV2 As BOOL
    SupportedSuplVersion As GNSS_SUPL_VERSION ' Location adapter does not refer to this SUPL version provided by GNSS driver today
    ' Geofence Parameters
    ' Only valid when GeofencingSupport field is non-zero
    MaxGeofencesSupported As Long
    ' SUPL Parameter
    SupportMultipleSuplRootCert As BOOL
    ' Bread crumbing
    GnssBreadCrumbPayloadVersion As Long ' BREADCRUMBING_UNSUPPORTED or BREADCRUMBING_VERSION_x
    MaxGnssBreadCrumbFixes As Long ' Must >= MIN_BREADCRUMBS_SUPPORTED
    Unused(0 To 495) As Byte
End Type

Public Type GNSS_PLATFORM_CAPABILITY
    Size As Long
    ' The version number of this structure is the DDK version against which the HLOS Platform (GNSS Adapter) is developed
    ' The HLOS controls the DDK versioning  such that the GNSS Adapter stays backward compatible with all prior versions of the Driver
    ' Driver compiled with a new DDK version requires the corresponding HLOS be compiled with the same or more recent DDK version
    Version As Long
    SupportAgnssInjection As BOOL
    AgnssFormatSupported As Long
    Unused(0 To 515) As Byte
End Type

Public Enum GNSS_DRIVERCOMMAND_TYPE
    GNSS_SetLocationServiceEnabled = &H01
    GNSS_SetLocationNIRequestAllowed = &H02
    GNSS_ForceSatelliteSystem = &H03
    GNSS_ForceOperationMode = &H04
    GNSS_ResetEngine = &H09
    GNSS_ClearAgnssData = &H0A
    GNSS_SetSuplVersion = &H0C ' GNSS_SUPL_VERSION
    GNSS_SetNMEALogging = &H0D
    GNSS_SetUplServerAccessInterval = &H0E
    GNSS_SetNiTimeoutInterval = &H0F
    GNSS_ResetGeofencesTracking = &H10
    GNSS_SetSuplVersion2 = &H11 ' GNSS_SUPL_VERSION_2
    GNSS_CustomCommand = &H0100
End Enum

