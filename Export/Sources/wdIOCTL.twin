Public Function GUID_MONITOR_OVERRIDE_PSEUDO_SPECIALIZED() As UUID
Static iid As UUID
    If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &Hf196c02f, &Hf86f, &H4f9a, &Haa, &H15, &He9, &Hce, &Hbd, &Hfe, &H3b, &H96)
GUID_MONITOR_OVERRIDE_PSEUDO_SPECIALIZED = iid
End Function
Public Function GUID_MONITOR_OVERRIDE_TEST_SPECIALIZED() As UUID
Static iid As UUID
    If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H457e531, &H3cb9, &H4a07, &H83, &Hc1, &Ha7, &H91, &H46, &Hc6, &H4d, &Hb3)
GUID_MONITOR_OVERRIDE_TEST_SPECIALIZED = iid
End Function

