    'BYTE  GetFreeSpaceSupported : 1;        // Supports DeviceDsmAction_GetFreeSpace
    'BYTE  MapSupported : 1;                 // Supports DeviceDsmAction_Map
    Bitfield As Byte
    Reserved1(0 To 6) As Byte
