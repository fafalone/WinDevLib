Public Type DEVICE_POWER_DESCRIPTOR
    Version As Long ' keep compatible with STORAGE_DESCRIPTOR_HEADER
    Size As Long ' keep compatible with STORAGE_DESCRIPTOR_HEADER
    DeviceAttentionSupported As Byte ' The device supports "device attention".
    AsynchronousNotificationSupported As Byte ' The device supports asynchronous notifications, delivered via IOCTL_STORAGE_EVENT_NOTIFICATION.
    IdlePowerManagementEnabled As Byte ' The device has been registered for runtime idle power management.
    D3ColdEnabled As Byte ' The device will be powered off when put into D3.
    D3ColdSupported As Byte ' The platform supports D3Cold for this device.
    NoVerifyDuringIdlePower As Byte ' Device require no verification during idle power transitions.
    Reserved(0 To 1) As Byte
    IdleTimeoutInMS As Long ' The idle timeout value in milliseconds. Only valid if IdlePowerManagementEnabled == TRUE.
End Type

