    ProtocolType As STORAGE_PROTOCOL_TYPE
    DataType As Long ' The value will be protocol specific, as defined in STORAGE_PROTOCOL_NVME_DATA_TYPE or STORAGE_PROTOCOL_ATA_DATA_TYPE.
    ProtocolDataValue As Long
    ProtocolDataSubValue As Long ' Data sub request value
    ProtocolDataOffset As Long ' The offset of data buffer is from beginning of this data structure.
    ProtocolDataLength As Long
    FixedProtocolReturnData As Long
    ProtocolDataSubValue2 As Long ' First additional data sub request value
    ProtocolDataSubValue3 As Long ' Second additional data sub request value
    ProtocolDataSubValue4 As Long ' Third additional data sub request value
    ProtocolDataSubValue5 As Long ' Fourth additional data sub request value
    ProtocolDataSubValue6 As Long ' Fifth additional data sub request value
    Reserved(0 To 3) As Long
End Type

