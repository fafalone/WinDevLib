    VIDEO_MODE_ASYNC_POINTER = &H01  ' 1 if the cursor can be updated
'  asynchronously to drawing operations.
    VIDEO_MODE_MONO_POINTER = &H02  ' 1 if a monochrome hardware pointer
'  is supported.
    VIDEO_MODE_COLOR_POINTER = &H04  ' 1 if a color hardware pointer is
'  supported.
    VIDEO_MODE_ANIMATE_START = &H08  ' The pointer being passed down has
    VIDEO_MODE_ANIMATE_UPDATE = &H10  ' the same hotspot as the previous
'  pointer
End Enum

