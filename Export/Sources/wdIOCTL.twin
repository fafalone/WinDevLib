' union {

    ' //
    ' //  Used to return the required buffer size if return code is STATUS_BUFFER_OVERFLOW
    ' //

    ' DWORD BufferLength;

    ' //
    ' //  On success the data is copied here.
    ' //

    ' BYTE  Buffer[1];
' } DUMMYUNIONNAME;
    BufferLength As Long

End Type

Public Type TXFS_WRITE_BACKUP_INFORMATION
    Buffer(0 To 0) As Byte
End Type

Public Enum TXFS_TRANSACTED_VERSIONS
    TXFS_TRANSACTED_VERSION_NONTRANSACTED = &HFFFFFFFE
    TXFS_TRANSACTED_VERSION_UNCOMMITTED = &HFFFFFFFF
End Enum
Public Type TXFS_GET_TRANSACTED_VERSION
    '  The version that this handle is opened to.  This will be
    '  TXFS_TRANSACTED_VERSION_UNCOMMITTED for nontransacted and
    '  transactional writer handles.
    ThisBaseVersion As TXFS_TRANSACTED_VERSIONS
    '  The most recent committed version available.
    LatestVersion As TXFS_TRANSACTED_VERSIONS
    '  If this is a handle to a miniversion, the ID of the miniversion.
    '  If it is not a handle to a miniversion, this field will be 0.
    ThisMiniVersion As Integer
    '  The first available miniversion.  Unless the miniversions are
    '  visible to the transaction bound to this handle, this field will be zero.
    FirstMiniVersion As Integer
    '  The latest available miniversion.  Unless the miniversions are
    '  visible to the transaction bound to this handle, this field will be zero.
    LatestMiniVersion As Integer
End Type

Public Enum TXFS_SAVEPOINTS
    ' Create a new savepoint.
    TXFS_SAVEPOINT_SET = &H00000001
    '   Roll back to a specified savepoint.
    TXFS_SAVEPOINT_ROLLBACK = &H00000002
    '   Clear (make unavailable for rollback) the most recently set savepoint
    '   that has not yet been cleared.
    TXFS_SAVEPOINT_CLEAR = &H00000004
    '   Clear all savepoints from the transaction.
    TXFS_SAVEPOINT_CLEAR_ALL = &H00000010
End Enum

Public Type TXFS_SAVEPOINT_INFORMATION
    '  Handle to the transaction on which to perform the savepoint operation.
    KtmTransaction As LongPtr
    '  Specifies the savepoint action to take.  A TXFS_SAVEPOINT_* value.
    ActionCode As TXFS_SAVEPOINTS
    '  In-parameter for TXFS_ROLLBACK_TO_SAVEPOINT - specifies the savepoint to which
    '  to roll back.
    '  Out-parameter for TXFS_SET_SAVEPOINT - the newly-created savepoint ID will be
    '  returned here.
    '  Not used for TXFS_CLEAR_SAVEPOINT or TXFS_CLEAR_ALL_SAVEPOINTS.
    SavepointId As Long
End Type

Public Type TXFS_CREATE_MINIVERSION_INFO
    StructureVersion As Integer
    StructureLength As Integer
    '  The base version for the newly created miniversion.
    BaseVersion As Long
    '  The miniversion that was just created.
    MiniVersion As Integer
End Type

Public Type TXFS_TRANSACTION_ACTIVE_INFO
    '  Whether or not the volume had active transactions when this snapshot was taken.
    TransactionsActiveAtSnapshot As CBoolean
End Type

Public Type BOOT_AREA_INFO
    BootSectorCount As Long ' the count of boot sectors present on the file system
    /*    struct {
    LARGE_INTEGER   Offset;
        } BootSectors[2];                    // variable number of boot sectors. */
    BootSectors0_Offset As LARGE_INTEGER
    BootSectors1_Offset As LARGE_INTEGER
End Type

Public Type RETRIEVAL_POINTER_BASE
    FileAreaOffset As LARGE_INTEGER ' sector offset to the first allocatable unit on the filesystem
End Type














Public Enum FSCTL_PERSISTENT_VOLUME_STATE_FLAGS
    PERSISTENT_VOLUME_STATE_SHORT_NAME_CREATION_DISABLED = (&H00000001)
' #if (_WIN32_WINNT >= _WIN32_WINNT_WIN8)
    PERSISTENT_VOLUME_STATE_VOLUME_SCRUB_DISABLED = (&H00000002)
' #endif  /* (_WIN32_WINNT >= _WIN32_WINNT_WIN8) */
' #if (_WIN32_WINNT >= _WIN32_WINNT_WINBLUE)
'   Persistent volume flags to control the file system's storage tiering
'   awareness.
    PERSISTENT_VOLUME_STATE_GLOBAL_METADATA_NO_SEEK_PENALTY = (&H00000004)
    PERSISTENT_VOLUME_STATE_LOCAL_METADATA_NO_SEEK_PENALTY = (&H00000008)
    PERSISTENT_VOLUME_STATE_NO_HEAT_GATHERING = (&H00000010)
' #endif /* (_WIN32_WINNT >= _WIN32_WINNT_WINBLUE) */
'   These are flags that define a volume's dependency on WimBoot file.
' #if (_WIN32_WINNT >= _WIN32_WINNT_WIN7)
'   The volume backs a system critical volume, typically the one that has wimboot
'   image file serving the system files
    PERSISTENT_VOLUME_STATE_CONTAINS_BACKING_WIM = (&H00000020)
'   The volume is backed by other volume that actually has the system files.
'   And hence this relies on the other volume being present in order for the system to boot up.
    PERSISTENT_VOLUME_STATE_BACKED_BY_WIM = (&H00000040)
' #endif /* (_WIN32_WINNT >= _WIN32_WINNT_WIN7) */
' #if (_WIN32_WINNT >= _WIN32_WINNT_WINTHRESHOLD)
'   Writes dynamic redirection on tiered volumes will be disabled
    PERSISTENT_VOLUME_STATE_NO_WRITE_AUTO_TIERING = (&H00000080)
' #endif // #if (_WIN32_WINNT >= _WIN32_WINNT_WINTHRESHOLD)
' #if (_WIN32_WINNT >= _WIN32_WINNT_WINTHRESHOLD)
'   Disable txf on volume
    PERSISTENT_VOLUME_STATE_TXF_DISABLED = (&H00000100)
' #endif // #if (_WIN32_WINNT >= _WIN32_WINNT_WINTHRESHOLD)
' #if (NTDDI_VERSION >= NTDDI_WIN10_RS5)
'   Always reallocate data writes
    PERSISTENT_VOLUME_STATE_REALLOCATE_ALL_DATA_WRITES = (&H00000200)
' #endif // #if (NTDDI_VERSION >= NTDDI_WIN10_RS5)
' #if (NTDDI_VERSION >= NTDDI_WIN10_MN)
'   This indicates that AutoChk modified this volume and is cleared by AutoChk
'   after it ensured that the volume is dismounted or the system is rebooted.
'   This can be set or queried.
    PERSISTENT_VOLUME_STATE_CHKDSK_RAN_ONCE = (&H00000400)
'   This again indicates that AutoChk modified this volume but is cleared by
'   NTFS on next mount.  So if this flag is set it means that the volume was
'   modified by AutoChk while it's still mounted and the on-disk state and
'   the in memory state could be different.  This can only be queried.
    PERSISTENT_VOLUME_STATE_MODIFIED_BY_CHKDSK = (&H00000800)
'   The volume was formatted as DAX.  The volume may not be mounted as DAX
'   if the storage is not DAX capable.  This can only be queried.
    PERSISTENT_VOLUME_STATE_DAX_FORMATTED = (&H00001000)
' #endif // #if (NTDDI_VERSION >= NTDDI_WIN10_MN)
' #if (NTDDI_VERSION >= NTDDI_WIN11_ZN)
'   The volume was formatted as a developer volume.  This can be used by the
'   file system and other system components to enable optimizations that doe
'   not require an administrator to trust the volume on a given machine.
'   This is set at format time and can only be queried.
    PERSISTENT_VOLUME_STATE_DEV_VOLUME = (&H00002000)
'   An adminstrator on a given machine had trust this volume and is willing
'   to enable optimizations like not having anti-virus filters attach to the
'   volume.  This information is persisted in the registry on a given machine.
'   This can be used by the file system and other system components to enable
'   optimizations that require an administrator to trust the volume on a given
'   machine.
'   NOTE: Today only developer volumes can be trusted, i.e. this flag can be
'   set only when PERSISTENT_VOLUME_STATE_DEV_VOLUME is set.
'   This can be set and queried.
    PERSISTENT_VOLUME_STATE_TRUSTED_VOLUME = (&H00004000)
' #endif // #if (NTDDI_VERSION >= NTDDI_WIN11_ZN)
End Enum

Public Type FILE_FS_PERSISTENT_VOLUME_INFORMATION
    VolumeFlags As FSCTL_PERSISTENT_VOLUME_STATE_FLAGS
    FlagMask As FSCTL_PERSISTENT_VOLUME_STATE_FLAGS
    Version As Long
    Reserved As Long
End Type

Public Type FILE_SYSTEM_RECOGNITION_INFORMATION
    FileSystem(0 To 8) As Byte
End Type

Public Enum FSCTL_OPLOCK_LEVELS
    OPLOCK_LEVEL_CACHE_READ = (&H00000001)
    OPLOCK_LEVEL_CACHE_HANDLE = (&H00000002)
    OPLOCK_LEVEL_CACHE_WRITE = (&H00000004)
End Enum

Public Enum FSCTL_OPLOCK_FLAGS
    REQUEST_OPLOCK_INPUT_FLAG_REQUEST = (&H00000001)
    REQUEST_OPLOCK_INPUT_FLAG_ACK = (&H00000002)
    REQUEST_OPLOCK_INPUT_FLAG_COMPLETE_ACK_ON_CLOSE = (&H00000004)
End Enum

Public Const REQUEST_OPLOCK_CURRENT_VERSION  = 1

Public Type REQUEST_OPLOCK_INPUT_BUFFER
    '  This should be set to REQUEST_OPLOCK_CURRENT_VERSION.
    StructureVersion As Integer
    StructureLength As Integer
    '  One or more OPLOCK_LEVEL_CACHE_* values to indicate the desired level of the oplock.
    RequestedOplockLevel As FSCTL_OPLOCK_LEVELS
    '  REQUEST_OPLOCK_INPUT_FLAG_* flags.
    Flags As FSCTL_OPLOCK_FLAGS
End Type

Public Enum FSCTL_OPLOCK_OUTPUT_FLAGS
    REQUEST_OPLOCK_OUTPUT_FLAG_ACK_REQUIRED = (&H00000001)
    REQUEST_OPLOCK_OUTPUT_FLAG_MODES_PROVIDED = (&H00000002)
' #if (NTDDI_VERSION >= NTDDI_WIN10_CU)
'  If the oplock request fails with STATUS_OPLOCK_NOT_GRANTED, this flag indicates that the oplock
'  could not be granted due to the presence of a writable user-mapped section.
    REQUEST_OPLOCK_OUTPUT_FLAG_WRITABLE_SECTION_PRESENT = (&H00000004)
    ' #if (NTDDI_VERSION >= NTDDI_WIN11_DT)
    REQUEST_OPLOCK_OUTPUT_FLAG_NON_CACHED_IO_PRESENT = (&H00000008)
End Enum

Public Type REQUEST_OPLOCK_OUTPUT_BUFFER
    '  This should be set to REQUEST_OPLOCK_CURRENT_VERSION.
    StructureVersion As Integer
    StructureLength As Integer
    '  One or more OPLOCK_LEVEL_CACHE_* values indicating the level of the oplock that
    '  was just broken.
    OriginalOplockLevel As FSCTL_OPLOCK_LEVELS
    '  One or more OPLOCK_LEVEL_CACHE_* values indicating the level to which an oplock
    '  is being broken, or an oplock level that may be available for granting, depending
    '  on the operation returning this buffer.
    NewOplockLevel As FSCTL_OPLOCK_LEVELS
    '  REQUEST_OPLOCK_OUTPUT_FLAG_* flags.
    Flags As FSCTL_OPLOCK_OUTPUT_FLAGS
    '  When REQUEST_OPLOCK_OUTPUT_FLAG_MODES_PROVIDED is set, and when the
    '  OPLOCK_LEVEL_CACHE_HANDLE level is being lost in an oplock break, these fields
    '  contain the access mode and share mode of the request that is causing the break.
    AccessMode As Long 'ACCESS_MASK
    ShareMode As Integer
End Type

Public Type STORAGE_QUERY_DEPENDENT_VOLUME_REQUEST
    RequestLevel As Long
    RequestFlags As Long
End Type

Public Const QUERY_DEPENDENT_VOLUME_REQUEST_FLAG_HOST_VOLUMES  = &H1
Public Const QUERY_DEPENDENT_VOLUME_REQUEST_FLAG_GUEST_VOLUMES  = &H2

Public Type STORAGE_QUERY_DEPENDENT_VOLUME_LEV1_ENTRY
    EntryLength As Long
    DependencyTypeFlags As Long
    ProviderSpecificFlags As Long
    VirtualStorageType As VIRTUAL_STORAGE_TYPE
End Type

Public Type STORAGE_QUERY_DEPENDENT_VOLUME_LEV2_ENTRY
    EntryLength As Long
    DependencyTypeFlags As Long
    ProviderSpecificFlags As Long
    VirtualStorageType As VIRTUAL_STORAGE_TYPE
    AncestorLevel As Long ' Root parent is 0, every child level after that is incremented
    HostVolumeNameOffset As Long
    HostVolumeNameSize As Long
    DependentVolumeNameOffset As Long
    DependentVolumeNameSize As Long
    RelativePathOffset As Long
    RelativePathSize As Long
    DependentDeviceNameOffset As Long
    DependentDeviceNameSize As Long
End Type

Public Type STORAGE_QUERY_DEPENDENT_VOLUME_RESPONSE
    ResponseLevel As Long
    NumberEntries As Long
    'union {
    '    STORAGE_QUERY_DEPENDENT_VOLUME_LEV1_ENTRY Lev1Depends[];
    '    STORAGE_QUERY_DEPENDENT_VOLUME_LEV2_ENTRY Lev2Depends[];
    '} DUMMYUNIONNAME;
    u As STORAGE_QUERY_DEPENDENT_VOLUME_LEV2_ENTRY
End Type

Public Enum SD_GLOBAL_CHANGE_TYPES
    SD_GLOBAL_CHANGE_TYPE_MACHINE_SID = 1
    SD_GLOBAL_CHANGE_TYPE_QUERY_STATS = (1& << 16)
    SD_GLOBAL_CHANGE_TYPE_ENUM_SDS = (2& << 16)
End Enum

Public Type SD_CHANGE_MACHINE_SID_INPUT
    '  The current machine SID to change.
    '  This defines the offset from the beginning of the SD_GLOBAL_CHANGE_INPUT
    '  structure of where the CurrentMachineSID to replace begins.  This will
    '  be a SID structure.  The length defines the length of the imbedded SID
    '  structure.
    CurrentMachineSIDOffset As Integer
    CurrentMachineSIDLength As Integer
    '  The new machine SID value to set in-place of the current machine SID
    '  This defines the offset from the beginning of the SD_GLOBAL_CHANGE_INPUT
    '  structure of where the NewMachineSID to set begins.  This will
    '  be a SID structure.  The length defines the length of the imbedded SID
    '  structure.
    NewMachineSIDOffset As Integer
    NewMachineSIDLength As Integer
End Type

Public Type SD_CHANGE_MACHINE_SID_OUTPUT
    '  How many entries were successfully changed in the $Secure stream
    NumSDChangedSuccess As LongLong
    '  How many entries failed the update in the $Secure stream
    NumSDChangedFail As LongLong
    '  How many entries are unused in the current security stream
    NumSDUnused As LongLong
    '  The total number of entries processed in the $Secure stream
    NumSDTotal As LongLong
    '  How many entries were successfully changed in the $MFT file
    NumMftSDChangedSuccess As LongLong
    '  How many entries failed the update in the $MFT file
    NumMftSDChangedFail As LongLong
    '  Total number of entries processed in the $MFT file
    NumMftSDTotal As LongLong
End Type

Public Type SD_QUERY_STATS_INPUT
    Reserved As Long
End Type

Public Type SD_QUERY_STATS_OUTPUT
    '  Stream size and allocation size for the security descriptor
    '  data stream ($Secure:$SDS).
    SdsStreamSize As LongLong
    SdsAllocationSize As LongLong
    '  Stream size and allocation size for the security ID index
    '  stream ($Secure:$SII).
    SiiStreamSize As LongLong
    SiiAllocationSize As LongLong
    '  Stream size and allocation size for the security descriptor
    '  hash index stream ($Secure:$SDH).
    SdhStreamSize As LongLong
    SdhAllocationSize As LongLong
    '  The total number of entries in the security descriptor data
    '  stream.
    NumSDTotal As LongLong
    '  The number of unused entries in the security descriptor data
    '  stream.
    NumSDUnused As LongLong
End Type

Public Type SD_ENUM_SDS_INPUT
    '  The byte offset within the security descriptor data stream to look
    '  for security descriptors.  This must be a multiple of 16.
    '  Note this is a virtual byte offset.  The security descriptor data
    '  stream contains some additional data embedded inside the stream for
    '  redundancy, and this extra data does not count toward this byte
    '  offset.
    StartingOffset As LongLong
    '  The maximum number of SD entries to return.  This is primarily
    '  useful for supporting a model where you only want one entry at
    '  a time.  Set to 0 for no max.
    MaxSDEntriesToReturn As LongLong
End Type

[Description("WARNING: Buffer substituted for variable C-style array.")]
Public Type SD_ENUM_SDS_ENTRY
    '  Hash value of the security decriptor.
    Hash As Long
    '  SecurityId for the security descriptor.
    SecurityId As Long
    '  Virtual byte offset of this header in the security descriptor
    '  data stream.
    Offset As LongLong
    '  Length of this header + security descriptor that follows this
    '  header.
    Length As Long
    '  Actual security decriptor, variable length.
    Descriptor(0 To 1023) As Byte
End Type

Public Type SD_ENUM_SDS_OUTPUT
    '  The current machine SID to change.
    '  This defines the offset from the beginning of the SD_GLOBAL_CHANGE_INPUT
    '  structure of where the CurrentMachineSID to replace begins.  This will
    '  be a SID structure.  The length defines the length of the imbedded SID
    '  structure.
    NextOffset As LongLong
    '  The total number of entries returned.
    NumSDEntriesReturned As LongLong
    '  The total number of bytes of entries returned.
    NumSDBytesReturned As LongLong
    '  Variable length array of security descriptor stream entries.
    '  There should be NumSDEntriesReturned of them.  To walk this array,
    '  first point to SDEntry[0], then advance a number of bytes equal
    '  to the entry's Length rounded up to a multiple of 16.  (Each entry
    '  will be aligned to a 16-byte boundary.)
    SDEntry(0 To 0) As SD_ENUM_SDS_ENTRY
End Type

Public Type SD_GLOBAL_CHANGE_INPUT
    '  Input flags (none currently defined)
    Flags As Long
    '  Specifies which type of change we are doing and pics which member
    '  of the below union is in use.
    ChangeType As Long
    'union {
    '    SD_CHANGE_MACHINE_SID_INPUT SdChange;
    '    SD_QUERY_STATS_INPUT SdQueryStats;
    '    SD_ENUM_SDS_INPUT SdEnumSds;
    '} DUMMYUNIONNAME;
    u(1) As LongLong
End Type

Public Type SD_GLOBAL_CHANGE_OUTPUT
    '  Output State Flags (none currently defined)
    Flags As Long
    '  Specifies which below union to use
    ChangeType As Long
    'union {
    '    SD_CHANGE_MACHINE_SID_OUTPUT SdChange;
    '    SD_QUERY_STATS_OUTPUT SdQueryStats;
    '    SD_ENUM_SDS_OUTPUT SdEnumSds;
    '} DUMMYUNIONNAME;
    u(7) As LongLong
End Type

Public Type LOOKUP_STREAM_FROM_CLUSTER_INPUT
    '  Flags for the operation.  Currently no flags are defined.
    Flags As Long
    '  Number of clusters in the following array of clusters.
    '  The input buffer must be large enough to contain this
    '  number or the operation will fail.
    NumberOfClusters As Long
    '  An array of one or more clusters to look up.
    Cluster(0 To 0) As LARGE_INTEGER
End Type

Public Type LOOKUP_STREAM_FROM_CLUSTER_OUTPUT
    '  Offset from the beginning of this structure to the first entry
    '  returned.  If no entries are returned, this value is zero.
    Offset As Long
    '  Number of matches to the input criteria.  Note that more matches
    '  may be found than entries returned if the buffer is not large
    '  enough.
    NumberOfMatches As Long
    '  Minimum size of the buffer, in bytes, which would be needed to
    '  contain all matching entries to the input criteria.
    BufferSizeRequired As Long
End Type

Public Enum LOOKUP_STREAM_FROM_CLUSTER_ENTRY_FLAGS
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_FLAG_PAGE_FILE = &H00000001
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_FLAG_DENY_DEFRAG_SET = &H00000002
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_FLAG_FS_SYSTEM_FILE = &H00000004
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_FLAG_TXF_SYSTEM_FILE = &H00000008
End Enum

Public Enum LOOKUP_STREAM_FROM_CLUSTER_ENTRY_ATTRIBUTES
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_ATTRIBUTE_MASK = &Hff000000
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_ATTRIBUTE_DATA = &H01000000
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_ATTRIBUTE_INDEX = &H02000000
    LOOKUP_STREAM_FROM_CLUSTER_ENTRY_ATTRIBUTE_SYSTEM = &H03000000
End Enum

[Description("WARNING: Buffer substituted for variable C-style array.")]
Public Type LOOKUP_STREAM_FROM_CLUSTER_ENTRY
    '  Offset from the beginning of this structure to the next entry
    '  returned.  If there are no more entries, this value is zero.
    OffsetToNext As Long
    '  Flags describing characteristics about this stream.
    Flags As LOOKUP_STREAM_FROM_CLUSTER_ENTRY_FLAGS
    '  This value is reserved and is currently zero.
    Reserved As LARGE_INTEGER
    '  This is the cluster that this entry refers to.  It will be one
    '  of the clusters passed in the input structure.
    Cluster As LARGE_INTEGER
    '  A NULL-terminated Unicode string containing the path of the
    '  object relative to the root of the volume.  This string
    '  will refer to the attribute or stream represented by the
    '  cluster.
    FileName(0 To (MAX_PATH - 1)) As Integer
End Type

Public Type FILE_TYPE_NOTIFICATION_INPUT
    '  Flags for this operation
    '  FILE_TYPE_NOTIFICATION_FLAG_*
    Flags As FILE_TYPE_NOTIFICATION_FLAGS
    '  A count of how many FileTypeID guids are given
    NumFileTypeIDs As Long
    '  This is a unique identifier for the type of file notification occurring
    FileTypeID(0 To 0) As UUID
End Type

Public Enum FILE_TYPE_NOTIFICATION_FLAGS
    FILE_TYPE_NOTIFICATION_FLAG_USAGE_BEGIN = &H00000001  'Set when adding the specified usage on the given file
    FILE_TYPE_NOTIFICATION_FLAG_USAGE_END = &H00000002  'Set when removing the specified usage on the given file
End Enum

Public Function FILE_TYPE_NOTIFICATION_GUID_PAGE_FILE() As UUID
Static iid As UUID
    If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H0d0a64a1, &H38fc, &H4db8, &H9f, &He7, &H3f, &H43, &H52, &Hcd, &H7c, &H5c)
FILE_TYPE_NOTIFICATION_GUID_PAGE_FILE = iid
End Function
Public Function FILE_TYPE_NOTIFICATION_GUID_HIBERNATION_FILE() As UUID
Static iid As UUID
    If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &Hb7624d64, &Hb9a3, &H4cf8, &H80, &H11, &H5b, &H86, &Hc9, &H40, &He7, &Hb7)
FILE_TYPE_NOTIFICATION_GUID_HIBERNATION_FILE = iid
End Function
Public Function FILE_TYPE_NOTIFICATION_GUID_CRASHDUMP_FILE() As UUID
Static iid As UUID
    If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H9d453eb7, &Hd2a6, &H4dbd, &Ha2, &He3, &Hfb, &Hd0, &Hed, &H91, &H09, &Ha9)
FILE_TYPE_NOTIFICATION_GUID_CRASHDUMP_FILE = iid
End Function












