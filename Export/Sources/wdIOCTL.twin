PARTITION_WINDOWS_SYSTEM_GUID = iid
End Function

Public Declare PtrSafe Function IsEqualPartitionType Lib "ole32" Alias "IsEqualGUID" (ByRef rguid1 As UUID, ByRef rguid2 As UUID) As BOOL

Public Function IsRecognizedGptPartition(ByRef t As UUID) As Boolean
    Return IsEqualPartitionType(t, PARTITION_BSP_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_DPP_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_BASIC_DATA_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_MAIN_OS_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_MSFT_RECOVERY_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_OS_DATA_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_PRE_INSTALLED_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_SERVICING_FILES_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_SERVICING_METADATA_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_SERVICING_RESERVE_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_SERVICING_STAGING_ROOT_GUID) OrElse _
           IsEqualPartitionType(t, PARTITION_WINDOWS_SYSTEM_GUID)
End Function


