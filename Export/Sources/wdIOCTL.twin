Public Const IOCTL_VOLUME_GET_BC_PROPERTIES           = &H56403C 'CTL_CODE(IOCTL_VOLUME_BASE, 15, METHOD_BUFFERED, FILE_READ_ACCESS)
Public Const IOCTL_VOLUME_ALLOCATE_BC_STREAM          = &H56C040 'CTL_CODE(IOCTL_VOLUME_BASE, 16, METHOD_BUFFERED, FILE_READ_ACCESS | FILE_WRITE_ACCESS)
Public Const IOCTL_VOLUME_FREE_BC_STREAM              = &H56C044 'CTL_CODE(IOCTL_VOLUME_BASE, 17, METHOD_BUFFERED, FILE_READ_ACCESS | FILE_WRITE_ACCESS)

Public Const IOCTL_VOLUME_BC_VERSION  = 1

Public Type VOLUME_GET_BC_PROPERTIES_INPUT
    Version As Long
    Reserved1 As Long
    LowestByteOffset As LongLong
    HighestByteOffset As LongLong
    AccessType As Long
    AccessMode As Long
End Type

Public Type VOLUME_GET_BC_PROPERTIES_OUTPUT
    ' Specifies the maximum number of requests
    ' that can be scheduled per period of time.
    MaximumRequestsPerPeriod As Long
    ' Specifies the minimum period that the
    ' device uses when scheduling requests.
    MinimumPeriod As Long
    ' Specifies the maximum transfer size supported
    ' for  bandwidth contracts  on this  device. To
    ' achieve the highest level of performance, all
    ' requests should be of this size.
    MaximumRequestSize As LongLong
    ' Specifies the estimated time taken to
    ' perform an  Io operation. This  field
    ' is for informational purposes only.
    EstimatedTimePerRequest As Long
    ' Specifies the number of requests that should be
    ' kept outstanding.  This helps  keep the  device
    ' device busy  and thus obtain maximum throughput
    ' This will only be filled in if the target  file
    ' has an outstanding contract.
    NumOutStandingRequests As Long
    ' Specifies the required size of requests in this
    ' stream.  This  will  only  be filled in  if the
    ' target file has an outstanding contract.
    RequestSize As LongLong
End Type

Public Type VOLUME_ALLOCATE_BC_STREAM_INPUT
    ' Specifies the corresponding structure
    ' version.
    Version As Long
    ' Specifies the number of requests that
    ' need to complete per period of time.
    RequestsPerPeriod As Long
    ' Specifies the period of time wherein the
    ' above number of requests must complete.
    Period As Long
    ' Indicates whether failures should be
    ' be retried or not.
    RetryFailures As Byte
    ' Indicates whether reqests that miss
    ' their deadline should  be discarded
    ' or not.
    Discardable As Byte
    ' For alignment purposes.
    Reserved1(0 To 1) As Byte
    ' Specifies the lowest byte offset of
    ' the file that is to be streamed.
    LowestByteOffset As LongLong
    ' Specifies the highest byte offset of
    ' the file that is to be streamed.
    HighestByteOffset As LongLong
    ' Indicates whether requests shall be
    ' comprised of reads, writes or both.
    AccessType As Long
    ' Indicates whether the Io requests to
    ' the file will be sequential or not.
    AccessMode As Long
End Type

Public Type VOLUME_ALLOCATE_BC_STREAM_OUTPUT
    ' Specifies the required size
    ' of requests in this stream.
    RequestSize As LongLong
    ' Specifies the number of requests that should be
    ' kept outstanding.  This helps  keep the  device
    ' device busy and thus obtain maximum throughput.
    NumOutStandingRequests As Long
End Type

Public Const IOCTL_VOLUME_IS_DYNAMIC                  = &H560048 'CTL_CODE(IOCTL_VOLUME_BASE, 18, METHOD_BUFFERED, FILE_ANY_ACCESS)
Public Const IOCTL_VOLUME_PREPARE_FOR_CRITICAL_IO     = &H56C04C 'CTL_CODE(IOCTL_VOLUME_BASE, 19, METHOD_BUFFERED, FILE_READ_ACCESS | FILE_WRITE_ACCESS)

Public Type FILE_EXTENT
    VolumeOffset As LongLong
    ExtentLength As LongLong
End Type

Public Type VOLUME_CRITICAL_IO
    ' Indicates whether requests shall be
    ' comprised of reads, writes or both.
    AccessType As Long
    ' Count of the number of extents that
    ' are contained within this structure.
    ExtentsCount As Long
    ' Specifies the extents along which
    ' the critical Io will be performed.
    Extents(0 To (ANYSIZE_ARRAY - 1)) As FILE_EXTENT
End Type

Public Const IOCTL_VOLUME_QUERY_ALLOCATION_HINT       = &H564052 'CTL_CODE(IOCTL_VOLUME_BASE, 20, METHOD_OUT_DIRECT, FILE_READ_ACCESS)

Public Type VOLUME_ALLOCATION_HINT_INPUT
    ' Specifies the granularity of
    ' the bitmap being requested.
    ClusterSize As Long
    ' Specifies the count of bits
    ' that are being requested.
    NumberOfClusters As Long
    ' Specifies the first cluster
    ' that is to be evaluated.
    StartingClusterNumber As LongLong
End Type

Public Type VOLUME_ALLOCATION_HINT_OUTPUT
    ' Specifies the bits, 1 per cluster
    ' indicating all of the good places
    ' where file data  may be allocated
    ' These bits are represented by a 0.
