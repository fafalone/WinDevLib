    'struct
    '{
    '    USHORT TransmissionMode     : 2;  // in
    '    USHORT ReportMipiErrors     : 1;  // in
    '    USHORT ClearMipiErrors      : 1;  // in
    '    USHORT SecondaryPort        : 1;  // in
    '    USHORT ManufacturingMode    : 1;  // in
    '    USHORT Reserved             :10;
    '};
