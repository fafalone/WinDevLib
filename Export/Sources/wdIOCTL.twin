#End Region

#Region "diskguid.h"

Public Function PARTITION_BASIC_DATA_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &HEBD0A0A2, &HB9E5, &H4433, &H87, &HC0, &H68, &HB6, &HB7, &H26, &H99, &HC7) ' Basic data partition
PARTITION_BASIC_DATA_GUID = iid
End Function
Public Function PARTITION_BSP_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H57434F53, &H4DF9, &H45B9, &H8E, &H9E, &H23, &H70, &HF0, &H06, &H45, &H7C) ' BSP partition
PARTITION_BSP_GUID = iid
End Function
Public Function PARTITION_CLUSTER_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &HDB97DBA9, &H0840, &H4BAE, &H97, &HF0, &HFF, &HB9, &HA3, &H27, &HC7, &HE1) ' Cluster metadata partition
PARTITION_CLUSTER_GUID = iid
End Function
Public Function PARTITION_DPP_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H57434F53, &H94CB, &H43F0, &HA5, &H33, &HD7, &H3C, &H10, &HCF, &HA5, &H7D) ' DPP partition
PARTITION_DPP_GUID = iid
End Function
Public Function PARTITION_ENTRY_UNUSED_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H00000000, &H0000, &H0000, &H00, &H00, &H00, &H00, &H00, &H00, &H00, &H00) ' Entry unused
PARTITION_ENTRY_UNUSED_GUID = iid
End Function
Public Function PARTITION_LDM_DATA_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &HAF9B60A0, &H1431, &H4F62, &HBC, &H68, &H33, &H11, &H71, &H4A, &H69, &HAD) ' Logical Disk Manager data partition
PARTITION_LDM_DATA_GUID = iid
End Function
Public Function PARTITION_LDM_METADATA_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H5808C8AA, &H7E8F, &H42E0, &H85, &HD2, &HE1, &HE9, &H04, &H34, &HCF, &HB3) ' Logical Disk Manager metadata partition
PARTITION_LDM_METADATA_GUID = iid
End Function
Public Function PARTITION_MAIN_OS_GUID() As UUID
Static iid As UUID
 If (iid.Data1 = 0) Then Call DEFINE_UUID(iid, &H57434F53, &H8F45, &H405E, &H8A, &H23, &H18, &H6D, &H8A, &H43, &H30, &HD3) ' Main OS partition
