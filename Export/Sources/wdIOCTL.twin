End Type

Public Type VIDEO_MODE
    RequestedMode As Long
End Type

Public Const VIDEO_MODE_NO_ZERO_MEMORY  = &H80000000    ' High order bit of the mode
                                                        '  determines if the set mode
                                                        '  should (0) or should not (1)
                                                        '  cause the video memory to be
                                                        '  zeroed out simultaneously to
                                                        '  the set mode operation.
Public Const VIDEO_MODE_MAP_MEM_LINEAR  = &H40000000    ' Miniports which support this
                                                        '  flag will set a linear mode
                                                        '  if possible when this flag
                                                        '  is set.  Note: Some miniports
                                                        '  may return a linear mode even
                                                        '  if this flag is not set.

Public Type VIDEO_MODE_INFORMATION
    Length As Long
    ModeIndex As Long
    VisScreenWidth As Long
    VisScreenHeight As Long
    ScreenStride As Long
    NumberOfPlanes As Long
    BitsPerPlane As Long
    Frequency As Long
    XMillimeter As Long
    YMillimeter As Long
    NumberRedBits As Long
    NumberGreenBits As Long
    NumberBlueBits As Long
    RedMask As Long
    GreenMask As Long
    BlueMask As Long
    AttributeFlags As VideoModeAttrFlags
    VideoMemoryBitmapWidth As Long
    VideoMemoryBitmapHeight As Long
    DriverSpecificAttributeFlags As Long
End Type

Public Enum VideoModeAttrFlags
    VIDEO_MODE_COLOR = &H0001  ' 0 = Mono-compatible, 1 = Color
    VIDEO_MODE_GRAPHICS = &H0002  ' 0 = Text mode, 1 = Graphics
    VIDEO_MODE_PALETTE_DRIVEN = &H0004  ' 0 = Colors are direct
'  1 = Colors are index to a palette
    VIDEO_MODE_MANAGED_PALETTE = &H0008  ' 0 = Palette is fixed (must be
'      queried from miniport
'  1 = Palette is settable.
    VIDEO_MODE_INTERLACED = &H0010  ' 1 = Mode is interlaced
'  0 = non-interlaced
    VIDEO_MODE_NO_OFF_SCREEN = &H0020  ' 1 = Offscreen memory CAN NOT be
'      used to store information.
'  0 = Offscreen memory is available
    VIDEO_MODE_NO_64_BIT_ACCESS = &H0040  ' 1 = 64 bit memory writes to frame
'      buffer are not handled properly.
'  0 = 64 bit memory writes to frame
'      buffer are handled properly.
    VIDEO_MODE_BANKED = &H0080  ' 0 = undefined
'  1 = this is a banked mode
    VIDEO_MODE_LINEAR = &H0100  ' 0 = undefined
'  1 = this is a linear mode
End Enum

