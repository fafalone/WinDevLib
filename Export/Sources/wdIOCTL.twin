    DeviceCount As Long ' >= 1
    DeviceDataLength As Long
    DeviceDataOffset As Long ' Offset from beginning of this data structure. The buffer contains an array of STORAGE_PHYSICAL_DEVICE_DATA.
    Reserved(0 To 2) As Long
End Type
Public Type STORAGE_PHYSICAL_TOPOLOGY_DESCRIPTOR
